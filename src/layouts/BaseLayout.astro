---
export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const SITE_URL = 'https://gusangciren.github.io';
const SITE_NAME = '像企业家一样写作';
const DEFAULT_DESC =
  '像企业家一样写作 —— 把写作当成一门生意。免费读完《选择改变命运》《闭环：在你睡觉时赚钱》与 YC 创业课中文版，以及 UAC 周刊全部往期。';
const pageDesc = description || DEFAULT_DESC;
const ogImage = image || '/images/logo-180x180.png';
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageURL = new URL(ogImage, SITE_URL).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <!-- 社交分享卡片（微信 / 微博 / X 等抓取标题、描述与缩略图） -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/png" sizes="32x32" href="/images/logo-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/logo-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/logo-180x180.png" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <!-- Static CSS — no build hash, safe for incremental deploys -->
    <link rel="stylesheet" href="/global.css" />
    <!-- 中文字体：经 BootCDN 加载（国内可访问，不走被墙的 Google Fonts） -->
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-inner">
        <a href="/" class="logo">
          <img src="/images/logo-header.png" alt="Logo" class="logo-img" />
          <span>像企业家一样写作</span>
        </a>
        <div class="nav-links">
          <a href="/book">书籍</a>
          <a href="/columns">专栏</a>
          <button id="nav-search-btn" class="nav-search-btn" aria-label="搜索" title="搜索（Ctrl/⌘ + K）">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
          </button>
        </div>
      </div>
    </nav>

    <!-- 搜索浮窗 -->
    <div id="search-overlay" class="search-overlay">
      <div class="search-modal">
        <div class="search-header">
          <input id="search-input" type="text" placeholder="搜索书籍、章节或关键词…" autocomplete="off" />
          <button id="search-close" class="search-close-btn" aria-label="关闭搜索">✕</button>
        </div>
        <div id="search-results" class="search-results"></div>
      </div>
    </div>


    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <p>© 2026 像企业家一样写作</p>
        <div class="footer-links">
          <a href="https://mp.weixin.qq.com/" target="_blank">公众号：种一个梦</a>
        </div>
      </div>
    </footer>
  <style is:global>
    /* ===== 导航搜索图标 ===== */
    .nav-search-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border: none;
      background: transparent;
      color: var(--color-text-secondary);
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
    }
    .nav-search-btn:hover {
      background: rgba(245,80,0,0.08);
      color: var(--color-accent);
    }

    /* ===== 搜索浮层 ===== */
    .search-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 999;
      display: none;
      align-items: flex-start;
      justify-content: center;
      padding-top: 12vh;
    }
    .search-overlay.active {
      display: flex;
    }

    .search-modal {
      background: #fff;
      width: 90%;
      max-width: 720px;
      border-radius: 16px;
      box-shadow: 0 24px 80px rgba(0,0,0,0.25);
      overflow: hidden;
      animation: searchSlideIn 0.25s ease;
    }
    @keyframes searchSlideIn {
      from { opacity: 0; transform: translateY(-16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .search-header {
      display: flex;
      align-items: center;
      border-bottom: 1px solid var(--color-border, #e5e5e5);
    }
    #search-input {
      flex: 1;
      border: none;
      outline: none;
      font-size: 1.1rem;
      padding: 22px 28px;
      background: transparent;
      color: var(--color-text, #1a1a1a);
      font-family: inherit;
    }
    #search-input::placeholder {
      color: var(--color-text-secondary, #999);
    }
    .search-close-btn {
      background: none;
      border: none;
      font-size: 1.3rem;
      color: var(--color-text-secondary, #999);
      cursor: pointer;
      padding: 0 20px;
      line-height: 1;
      transition: color 0.2s;
    }
    .search-close-btn:hover {
      color: var(--color-accent, #f55000);
    }
    .search-results {
      max-height: 50vh;
      overflow-y: auto;
      padding: 8px 0;
    }
    .search-result-item {
      display: block;
      text-decoration: none;
      color: inherit;
      padding: 14px 24px;
      transition: background 0.15s;
    }
    .search-result-item:hover {
      background: var(--color-accent-light, #fff5f0);
    }
    .search-result-title {
      font-size: 0.95rem;
      font-weight: 600;
      margin-bottom: 4px;
      color: var(--color-text, #1a1a1a);
    }
    .search-result-desc {
      font-size: 0.82rem;
      color: var(--color-text-secondary, #888);
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .search-result-type {
      display: inline-block;
      font-size: 0.7rem;
      padding: 1px 6px;
      border-radius: 4px;
      background: var(--color-accent-light, #fff5f0);
      color: var(--color-accent, #f55000);
      margin-right: 6px;
      vertical-align: middle;
    }
    .search-empty {
      padding: 32px 24px;
      text-align: center;
      color: var(--color-text-secondary, #999);
      font-size: 0.9rem;
    }

    mark.search-highlight {
      background: linear-gradient(120deg, #ffe066 0%, #ffe066 100%);
      color: #1a1a1a;
      padding: 1px 3px;
      border-radius: 3px;
      animation: searchHighlightPop 0.35s ease;
    }

    @keyframes searchHighlightPop {
      0%   { transform: scale(1); box-shadow: 0 0 0 0 rgba(255,224,102,0.7); }
      50%  { transform: scale(1.05); box-shadow: 0 0 12px 4px rgba(255,224,102,0.5); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255,224,102,0); }
    }

    @media (max-width: 640px) {
      .search-modal { width: 96%; border-radius: 12px; }
      #search-input { padding: 16px 18px; font-size: 1rem; }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
    let _searchIndex = null;

    async function loadSearchIndex() {
      if (_searchIndex) return _searchIndex;
      try {
        const resp = await fetch('/search.json?t=' + Date.now());
        _searchIndex = await resp.json();
      } catch (e) {
        console.warn('search.json load failed', e);
        _searchIndex = { posts: [], books: [] };
      }
      return _searchIndex;
    }

    function openSearch(initialQuery) {
      const overlay = document.getElementById('search-overlay');
      const input = document.getElementById('search-input');
      overlay.classList.add('active');
      input.value = initialQuery || '';
      input.focus();
      renderResults(input.value);
    }

    function closeSearch() {
      document.getElementById('search-overlay').classList.remove('active');
    }

    function getSnippet(text, keyword, radius) {
      radius = radius || 30;
      if (!text) return '';
      const idx = text.toLowerCase().indexOf(keyword.toLowerCase());
      if (idx === -1) return text.substring(0, 80);
      const start = Math.max(0, idx - radius);
      const end = Math.min(text.length, idx + keyword.length + radius);
      let s = text.substring(start, end);
      if (start > 0) s = '…' + s;
      if (end < text.length) s = s + '…';
      return s;
    }

    function renderResults(query) {
      const container = document.getElementById('search-results');
      if (!query.trim()) {
        container.innerHTML = '<div class="search-empty">输入关键词搜索书籍和章节…</div>';
        return;
      }
      const q = query.toLowerCase();
      const index = _searchIndex || { posts: [], books: [] };
      const matchedPosts = index.posts.filter(p =>
        p.title.toLowerCase().includes(q) ||
        (p.desc || '').toLowerCase().includes(q) ||
        (p.content || '').toLowerCase().includes(q)
      );
      const matchedBooks = index.books.filter(b =>
        b.title.toLowerCase().includes(q) ||
        (b.desc || '').toLowerCase().includes(q) ||
        (b.content || '').toLowerCase().includes(q)
      );
      if (matchedPosts.length === 0 && matchedBooks.length === 0) {
        container.innerHTML = '<div class="search-empty">没有找到相关结果</div>';
        return;
      }
      let html = '';
      matchedPosts.forEach(p => {
        const snippet = getSnippet(p.content || '', q, 35);
        const displayDesc = (p.desc || '') || snippet;
        html += '<a href="/blog/' + p.slug + '?q=' + encodeURIComponent(q) + '" class="search-result-item">' +
          '<div class="search-result-title"><span class="search-result-type">章节</span>' + p.title + '</div>' +
          '<div class="search-result-desc">' + displayDesc + '</div>' +
        '</a>';
      });
      matchedBooks.forEach(b => {
        const snippet = getSnippet(b.content || '', q, 35);
        const displayDesc = (b.desc || '') || snippet;
        html += '<a href="/book/' + b.slug + '?q=' + encodeURIComponent(q) + '" class="search-result-item">' +
          '<div class="search-result-title"><span class="search-result-type">书籍</span>' + b.title + '</div>' +
          '<div class="search-result-desc">' + displayDesc + '</div>' +
        '</a>';
      });
      container.innerHTML = html;
    }

    // ===== Hero 内联搜索（方案 B） =====
    function closeHeroSearch() {
      const dropdown = document.getElementById('hero-search-dropdown');
      if (dropdown) { dropdown.classList.remove('show'); dropdown.innerHTML = ''; }
    }

    async function renderHeroResults(query) {
      const container = document.getElementById('hero-search-dropdown');
      if (!container) return;
      if (!query.trim()) { closeHeroSearch(); return; }
      const index = await loadSearchIndex();
      const q = query.toLowerCase();
      const matchedPosts = index.posts.filter(p =>
        p.title.toLowerCase().includes(q) ||
        (p.desc || '').toLowerCase().includes(q) ||
        (p.content || '').toLowerCase().includes(q)
      );
      const matchedBooks = index.books.filter(b =>
        b.title.toLowerCase().includes(q) ||
        (b.desc || '').toLowerCase().includes(q) ||
        (b.content || '').toLowerCase().includes(q)
      );
      if (matchedPosts.length === 0 && matchedBooks.length === 0) {
        container.innerHTML = '<div class="search-empty">没有找到相关结果</div>';
        container.classList.add('show');
        return;
      }
      const total = matchedPosts.length + matchedBooks.length;
      const showPosts = matchedPosts.slice(0, 4);
      const showBooks = matchedBooks.slice(0, 3);
      let html = '';
      showPosts.forEach(p => {
        const snippet = getSnippet(p.content || '', q, 35);
        const displayDesc = (p.desc || '') || snippet;
        html += '<a href="/blog/' + p.slug + '?q=' + encodeURIComponent(q) + '" class="search-result-item">' +
          '<div class="search-result-title"><span class="search-result-type">章节</span>' + p.title + '</div>' +
          '<div class="search-result-desc">' + displayDesc + '</div>' +
        '</a>';
      });
      showBooks.forEach(b => {
        const snippet = getSnippet(b.content || '', q, 35);
        const displayDesc = (b.desc || '') || snippet;
        html += '<a href="/book/' + b.slug + '?q=' + encodeURIComponent(q) + '" class="search-result-item">' +
          '<div class="search-result-title"><span class="search-result-type">书籍</span>' + b.title + '</div>' +
          '<div class="search-result-desc">' + displayDesc + '</div>' +
        '</a>';
      });
      if (total > showPosts.length + showBooks.length) {
        html += '<a href="#" class="hero-search-all" data-q="' + encodeURIComponent(q) + '">查看全部 ' + total + ' 条结果 →</a>';
      }
      container.innerHTML = html;
      container.classList.add('show');
    }

    function initHeroSearch() {
      const input = document.getElementById('hero-search-input');
      const dropdown = document.getElementById('hero-search-dropdown');
      const goBtn = document.getElementById('hero-search-go');
      if (!input || !dropdown) return;

      let inputTimeout;
      input.addEventListener('input', () => {
        clearTimeout(inputTimeout);
        inputTimeout = setTimeout(() => renderHeroResults(input.value), 120);
      });
      input.addEventListener('focus', () => { if (input.value.trim()) renderHeroResults(input.value); });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          loadSearchIndex().then(() => { closeHeroSearch(); openSearch(input.value); });
        }
        if (e.key === 'Escape') { closeHeroSearch(); input.blur(); }
      });

      if (goBtn) {
        goBtn.addEventListener('click', () => {
          loadSearchIndex().then(() => { closeHeroSearch(); openSearch(input.value); });
        });
      }

      dropdown.addEventListener('click', (e) => {
        const all = e.target.closest('.hero-search-all');
        if (all) {
          e.preventDefault();
          const q = decodeURIComponent(all.getAttribute('data-q') || '');
          loadSearchIndex().then(() => { closeHeroSearch(); openSearch(q); });
        }
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('.hero-search')) closeHeroSearch();
      });
    }

    initHeroSearch();

    // ===== 导航搜索图标（全站兜底入口） =====
    const navSearchBtn = document.getElementById('nav-search-btn');
    if (navSearchBtn) {
      navSearchBtn.addEventListener('click', () => {
        loadSearchIndex().then(() => openSearch());
      });
    }

    document.getElementById('search-close').addEventListener('click', closeSearch);
    document.getElementById('search-overlay').addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeSearch();
    });
    document.getElementById('search-input').addEventListener('input', (e) => {
      renderResults(e.target.value);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSearch();
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        loadSearchIndex().then(() => openSearch());
      }
    });
    });
  </script>

  <!-- 页面关键词高亮（从搜索结果跳转过来时） -->
  <script is:inline>
    (function() {
      function getQueryParam(name) {
        const url = new URL(window.location.href);
        return url.searchParams.get(name) || '';
      }

      function escapeRegExp(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      }

      function highlightKeyword(keyword) {
        if (!keyword.trim()) return;
        const main = document.querySelector('main');
        if (!main) return;

        const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT, null, false);
        const nodesToReplace = [];
        const regex = new RegExp('(' + escapeRegExp(keyword) + ')', 'gi');

        let node;
        while ((node = walker.nextNode())) {
          if (node.parentElement && node.parentElement.tagName === 'MARK') continue;
          if (regex.test(node.textContent)) {
            nodesToReplace.push(node);
          }
        }

        let firstMark = null;
        nodesToReplace.forEach(textNode => {
          const span = document.createElement('span');
          span.innerHTML = textNode.textContent.replace(regex, '<mark class="search-highlight">$1</mark>');
          const marks = span.querySelectorAll('mark');
          if (marks.length > 0 && !firstMark) {
            firstMark = marks[0];
          }
          const fragment = document.createDocumentFragment();
          while (span.firstChild) {
            fragment.appendChild(span.firstChild);
          }
          textNode.parentNode.replaceChild(fragment, textNode);
        });

        if (firstMark) {
          firstMark.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(function() {
            const marks = main.querySelectorAll('mark.search-highlight');
            marks.forEach(function(m) {
              const parent = m.parentNode;
              parent.replaceChild(document.createTextNode(m.textContent), m);
              parent.normalize();
            });
          }, 6000);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          highlightKeyword(getQueryParam('q'));
        });
      } else {
        highlightKeyword(getQueryParam('q'));
      }
    })();
  </script>

  <!-- 代码块复制按钮 -->
  <script is:inline>
    (function() {
      function initCopyButtons() {
        document.querySelectorAll('.prose pre').forEach(function(pre) {
          if (pre.querySelector('.copy-btn')) return;
          var btn = document.createElement('button');
          btn.className = 'copy-btn';
          btn.textContent = '复制';
          btn.setAttribute('aria-label', '复制代码');
          btn.addEventListener('click', function() {
            var code = pre.querySelector('code');
            var text = code ? code.innerText : pre.innerText;
            navigator.clipboard.writeText(text).then(function() {
              btn.textContent = '已复制';
              btn.classList.add('copied');
              setTimeout(function() {
                btn.textContent = '复制';
                btn.classList.remove('copied');
              }, 2000);
            }).catch(function() {
              btn.textContent = '失败';
              setTimeout(function() { btn.textContent = '复制'; }, 2000);
            });
          });
          pre.style.position = 'relative';
          pre.appendChild(btn);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCopyButtons);
      } else {
        initCopyButtons();
      }
    })();
  </script>

</html>
