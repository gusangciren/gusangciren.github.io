---
interface Props {
  title?: string;
  primaryText?: string;
  primaryLink?: string;
  secondaryText?: string;
  secondaryLink?: string;
}
const {
  title = '觉得有用？继续阅读',
  primaryText = '查看书籍',
  primaryLink = '/book',
  secondaryText = '',
  secondaryLink = '/book',
} = Astro.props;
---

<div class="cta-box">
  <p>{title}</p>
  <div class="cta-buttons">
    <a href={primaryLink} class="cta-btn cta-btn-primary">{primaryText}</a>
    {secondaryText && (
      <a href={secondaryLink} class="cta-btn cta-btn-secondary">{secondaryText}</a>
    )}
  </div>
</div>
