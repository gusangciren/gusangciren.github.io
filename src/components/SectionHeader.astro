---
interface Props {
  title: string;
  link?: string;
  linkText?: string;
  icon?: 'book' | 'pen' | 'none';
}
const { title, link, linkText = '查看全部 →', icon = 'none' } = Astro.props;
---

<div class="section-header">
  <div class="sh-title">
    {icon === 'book' && (
      <svg class="sh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
    )}
    {icon === 'pen' && (
      <svg class="sh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
    )}
    <h2>{title}</h2>
  </div>
  {link && <a href={link} class="see-all">{linkText}</a>}
</div>
