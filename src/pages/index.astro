---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ReaderLetter from '../components/ReaderLetter.astro';
import { getCollection } from 'astro:content';
import { columns } from '../data/columns';

const writeCol = columns.find((c) => c.id === 'write-like-entrepreneur');
const uacCol = columns.find((c) => c.id === 'uac-weekly');
const stationDefs = [
  { label: '一句话', issue: 1, sub: '随手记录 · 01 期' },
  { label: '一篇文章', issue: 3, sub: '250 字攒够成文 · 03 期' },
  { label: '一本书', issue: 16, sub: '知识卡片成书 · 16 期' },
  { label: '一笔收入', issue: 17, sub: '让自己产品化 · 17 期' },
  { label: '一门生意', issue: 19, sub: '打造别人想要的东西 · 19 期' },
];
const stations = stationDefs.map((s) => {
  const it = writeCol?.issues.find((i) => i.issue === s.issue);
  return { ...s, url: it?.url };
});
const writeCount = writeCol?.issueCount ?? 0;
const uacCount = uacCol?.issueCount ?? 0;
const totalIssues = uacCount + writeCount;
const columnsHref = '/columns';

const books = await getCollection('books');
const posts = await getCollection('blog');

books.sort((a, b) => a.data.order - b.data.order);

const firstChapterMap = new Map();
const chapterCountMap = new Map();
for (const book of books) {
  const chapters = posts
    .filter(p => p.data.series === book.data.seriesName && p.data.seriesOrder !== undefined)
    .sort((a, b) => (a.data.seriesOrder as number) - (b.data.seriesOrder as number));
  if (chapters.length > 0) {
    firstChapterMap.set(book.id, chapters[0].data.slug);
  }
  chapterCountMap.set(book.id, chapters.length);
}

function getUnit(book) {
  const t = book.data.title || '';
  const s = book.data.subtitle || '';
  if (t.includes('YC') || t.includes('课') || s.includes('讲')) return '讲';
  return '章';
}

function titleWithBrackets(name) {
  /* 只要含中文就加书名号（含 YC 创业课这类中英混排），纯英文书名才不加 */
  return /[一-龥]/.test(name) ? `《${name}》` : name;
}

---

<BaseLayout title="像企业家一样写作" shareCorner>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <h1>Build, sell, write, read, invest, and own.</h1>
      <p class="hero-cn">构建，销售，写作，阅读，投资，掌控——<strong>把这些变成习惯。</strong></p>
      <div class="hero-search">
        <div class="hero-search-box">
          <input id="hero-search-input" type="text" placeholder="我想知道····" autocomplete="off" />
          <button id="hero-search-go" class="hero-search-go" type="button" aria-label="搜索">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
          </button>
        </div>
        <div id="hero-search-dropdown" class="hero-search-dropdown"></div>
      </div>
      <p class="mobile-tip">（我更希望你在电脑上打开我）</p>
      <div class="site-url-box">
        <span class="site-url-text">gusangciren.github.io</span>
        <button class="site-url-btn" type="button" data-url="gusangciren.github.io">复制</button>
      </div>
    </div>
  </section>

  <!-- Books Preview：封面流 · 站点白底 · /book 同款白卡（2026-09-29 ②） -->
  <section class="section section-books">
    <div class="section-inner">
      <div class="books-cf">
        <div class="cf-head">
          <div class="cf-title">书籍<span class="hl">作品</span></div>
          <div class="cf-sub">我这辈子遇到的聪明人，没有一个不每天阅读的——没有，一个都没有。（查理·芒格）</div>
        </div>
        <div class="cf-wrap" id="books-deck">
          {books.map((book, i) => {
            const slug = book.slug || book.id.replace(/\.(md|mdx)$/i, '');
            const firstChapter = firstChapterMap.get(book.id);
            const chapterCount = chapterCountMap.get(book.id) || 0;
            const unit = getUnit(book);
            const href = firstChapter ? `/blog/${firstChapter}` : `/book/${slug}`;
            const meta = book.data.ongoing ? '连载中' : `${chapterCount} ${unit} · 免费`;
            const fullTitle = titleWithBrackets(book.data.subtitle ? `${book.data.title}：${book.data.subtitle}` : book.data.title);
            return (
              <a href={href} class="deck-card">
                <div class="dc-cover">
                  {book.data.ongoing && <span class="dc-ongoing">持续更新中…</span>}
                  {book.data.isNew && !book.data.ongoing && <span class="dc-new">NEW</span>}
                  <img src={book.data.cover} alt={book.data.title} loading="lazy" onerror="this.classList.add('broken')" />
                </div>
                <div class="dc-body">
                  <div class="dc-title">{fullTitle}</div>
                  <p class="dc-desc">{book.data.description}</p>
                  <div class="dc-foot">
                    <span class="dc-meta">{meta}</span>
                    <span class="dc-go">开始阅读 →</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      document.querySelectorAll('.site-url-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var url = btn.dataset.url;
          function done() {
            btn.classList.add('copied');
            btn.textContent = '已复制';
            setTimeout(function () {
              btn.classList.remove('copied');
              btn.textContent = '复制';
            }, 1500);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(done).catch(function () {
              var input = document.createElement('input');
              input.value = url;
              document.body.appendChild(input);
              input.select();
              document.execCommand('copy');
              document.body.removeChild(input);
              done();
            });
          } else {
            var input = document.createElement('input');
            input.value = url;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            done();
          }
        });
      });
    })();

    (function () {
      var wrap = document.getElementById('books-deck');
      if (!wrap) return;
      var cards = Array.prototype.slice.call(wrap.querySelectorAll('.deck-card'));
      var n = cards.length, center = 0, timer = null;
      var FALL = 0.19; /* 侧卡缩放衰减：d=1 → .81，d=2 → .62 */
      function halfWidth() { return Math.min(1200, window.innerWidth - 48) / 2; }
      /* 桌面/平板：最外侧卡（d=2）右缘正好对齐专栏内容区边缘 */
      function spacing() {
        var half = halfWidth();
        var cw = (cards[0] ? cards[0].offsetWidth : 264) / 2;
        var sp = (half - cw * (1 - 2 * FALL)) / 2;
        return Math.max(150, Math.min(260, sp));
      }
      function render(off) {
        var mobile = window.innerWidth < 640;
        var cw = (cards[0] ? cards[0].offsetWidth : 264) / 2;
        /* 手机：两侧卡探出 ~90px 隐约可见下一本（渐隐遮罩融掉边缘，不露被裁文字），d≥2 隐藏 */
        var PEEK = 90;
        var sp = mobile ? (halfWidth() + cw * 0.88 - PEEK) : spacing();
        var off = off || 0;
        cards.forEach(function (c, i) {
          var d = (i - center + n) % n; if (d > n / 2) d -= n;
          var ad = Math.abs(d);
          var hidden = mobile && ad >= 2;
          var s = mobile ? (ad === 0 ? 1 : 0.88) : 1 - Math.min(ad, 2) * FALL;
          c.style.transform = 'translateX(' + (d * sp + off) + 'px) scale(' + s.toFixed(3) + ')';
          c.style.zIndex = 10 - ad * 2;
          /* 浅底：侧卡淡出到白（降不透明度 + 降饱和），而非压暗 */
          c.style.opacity = hidden ? '0' : (mobile && ad > 0 ? '0.5' : (1 - Math.min(ad, 2) * 0.42).toFixed(2));
          c.style.pointerEvents = hidden ? 'none' : '';
          c.style.filter = ad > 0 ? 'saturate(' + (1 - Math.min(ad, 2) * 0.4).toFixed(2) + ')' : 'none';
          c.classList.toggle('is-center', ad === 0);
        });
      }
      function go(i) { center = ((i % n) + n) % n; render(); }
      var lastDrag = 0;
      cards.forEach(function (c, i) {
        c.addEventListener('click', function (e) {
          if (Date.now() - lastDrag < 400) { e.preventDefault(); return; } /* 刚滑完不误触链接 */
          if (i !== center) { e.preventDefault(); go(i); }
        });
      });
      /* 手机：手指横向滑动切换（实时跟手，松手按阈值吸附；竖向滚动不受影响） */
      var tsX = 0, tsY = 0, dragX = 0, axis = null, dragging = false;
      function setCardTransition(on) {
        cards.forEach(function (c) { c.style.transition = on ? '' : 'none'; });
      }
      wrap.addEventListener('touchstart', function (e) {
        if (window.innerWidth < 640 && e.touches.length === 1) {
          if (timer) { clearInterval(timer); timer = null; }
          tsX = e.touches[0].clientX; tsY = e.touches[0].clientY;
          dragging = true; axis = null; dragX = 0;
        }
      }, { passive: true });
      wrap.addEventListener('touchmove', function (e) {
        if (!dragging) return;
        var dx = e.touches[0].clientX - tsX, dy = e.touches[0].clientY - tsY;
        if (!axis) {
          if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
          axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
        }
        if (axis !== 'x') return;
        e.preventDefault();
        dragX = dx;
        setCardTransition(false);
        render(dragX);
      }, { passive: false });
      function touchEnd() {
        if (!dragging) return;
        dragging = false;
        setCardTransition(true);
        var moved = dragX; dragX = 0;
        if (axis === 'x' && Math.abs(moved) > 40) {
          lastDrag = Date.now();
          go(center + (moved < 0 ? 1 : -1));
        } else {
          render();
        }
        start();
      }
      wrap.addEventListener('touchend', touchEnd);
      wrap.addEventListener('touchcancel', touchEnd);
      wrap.addEventListener('mouseenter', function () { if (timer) { clearInterval(timer); timer = null; } });
      wrap.addEventListener('mouseleave', start);
      function start() { if (!timer) timer = setInterval(function () { go(center + 1); }, 3500); }
      window.addEventListener('resize', render);
      render(); start();
    })();
  </script>

  <!-- Columns Preview · 深夜书房「一条路」 -->
  <section class="section section-columns">
    <div class="section-inner">
      <div class="cd">
        <h3 class="cd-title">写作这门生意，<em>我把每一步都走给你看</em>。</h3>
        <p class="cd-sub">买一份合集，两个专栏一起解锁——1）周刊每周给你新的东西读，2）书籍陪你走到第一笔收入。</p>

        <div class="cd-path">
          <span class="cd-lamp" style="left:20%"></span>
          <span class="cd-lamp" style="left:40%"></span>
          <span class="cd-lamp" style="left:60%"></span>
          <span class="cd-lamp" style="left:80%"></span>
          {stations.map((s) => (
            <div class="cd-st">
              <span class="cd-dot"></span>
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="cd-st-label">{s.label}</a>
              <span class="cd-st-sub">{s.sub}</span>
            </div>
          ))}
        </div>

        <div class="cd-legend">
          <div class="cd-legend-row">
            <span><i class="cd-lit"></i>五个站 = <b>《写作并变现》{writeCount} 期</b>，从头走到尾</span>
            <span><i class="cd-dim"></i>小灯 = <b>《UAC 周刊》{uacCount} 期</b>，每周一篇沿途输入</span>
          </div>
        </div>

        <div class="cd-cta">
          <a href={columnsHref} class="cd-btn">从一句话走到第一笔收入 →</a>
          <span class="cd-note">{totalIssues} 期全部可读 · 每周更新</span>
        </div>
      </div>
    </div>
  </section>

  <style>
    .section-columns{background:radial-gradient(1600px 620px at 50% -120px,#2b2317 0%,#181308 55%,#100d08 100%)}
    .section-columns .section-inner{max-width:1400px}
    .cd{position:relative;max-width:1400px;margin:0 auto;color:#f0e9dc}
    .cd-title{position:relative;text-align:center;font-size:2.2rem;font-weight:700;line-height:1.55;color:#f7f1e4;max-width:1000px;margin:0 auto}
    .cd-title em{font-style:normal;color:#e8a04c;text-shadow:0 0 26px rgba(232,160,76,.35)}
    .cd-sub{position:relative;text-align:center;font-size:14px;color:#a89e8d;margin-top:12px;max-width:760px;margin-left:auto;margin-right:auto}
    .cd-path{position:relative;max-width:1360px;margin:52px auto 0;display:flex;justify-content:space-between}
    .cd-path::before{content:'';position:absolute;top:7px;left:10%;right:10%;height:1px;background:linear-gradient(90deg,rgba(232,160,76,.18),rgba(232,160,76,.5))}
    .cd-st{position:relative;flex:1;text-align:center;padding:0 6px}
    .cd-dot{display:block;width:15px;height:15px;border-radius:50%;background:#181308;border:2px solid #a8763a;margin:0 auto;position:relative;z-index:1;transition:.2s}
    .cd-st:hover .cd-dot{border-color:#e8a04c;background:#2b2317;box-shadow:0 0 14px rgba(232,160,76,.5)}
    .cd-st:last-child .cd-dot{background:#e8a04c;border-color:#e8a04c;animation:cdGlow 2.8s ease-in-out infinite}
    @keyframes cdGlow{0%,100%{box-shadow:0 0 10px rgba(232,160,76,.45)}50%{box-shadow:0 0 26px rgba(232,160,76,.95)}}
    .cd-st-label{display:block;font-size:15.5px;color:#ece3d2;margin-top:12px;transition:.2s;text-decoration:none}
    .cd-st:hover .cd-st-label{color:#e8a04c}
    .cd-st-sub{display:block;font-size:11.5px;color:#9a8f7d;margin-top:3px;white-space:nowrap}
    .cd-st:first-child .cd-st-sub{color:#c9973f}
    .cd-lamp{position:absolute;top:4.5px;width:7px;height:7px;border-radius:50%;background:rgba(232,160,76,.38);transform:translateX(-50%);z-index:0}
    .cd-legend{position:relative;max-width:860px;margin:28px auto 0;text-align:center;font-size:13px;color:#a89e8d}
    .cd-legend-row{display:flex;justify-content:center;gap:26px;flex-wrap:wrap}
    .cd-legend i{display:inline-block;vertical-align:middle;margin-right:7px;border-radius:50%}
    .cd-lit{width:11px;height:11px;background:#e8a04c;box-shadow:0 0 8px rgba(232,160,76,.6)}
    .cd-dim{width:7px;height:7px;background:rgba(232,160,76,.38)}
    .cd-legend b{color:#d8cfbb;font-weight:600}
    .cd-cta{position:relative;text-align:center;margin-top:30px}
    .cd-btn{display:inline-block;background:linear-gradient(180deg,#e8a04c,#d98a30);color:#17130d;font-weight:700;font-size:14px;border-radius:9px;padding:12px 34px;text-decoration:none;box-shadow:0 10px 26px rgba(232,160,76,.3);transition:.15s}
    .cd-btn:hover{transform:translateY(-1px);box-shadow:0 14px 32px rgba(232,160,76,.42)}
    .cd-note{display:block;font-size:12px;color:#9a8f7d;margin-top:10px}
    .letter-gap{margin-top:72px}
    @media(max-width:860px){
      .cd-title{font-size:1.6rem}
      .cd-path{flex-direction:column;gap:24px;align-items:flex-start;max-width:320px}
      .cd-path::before{left:7px;right:auto;top:8px;bottom:8px;width:1px;height:auto;background:linear-gradient(180deg,rgba(232,160,76,.18),rgba(232,160,76,.5))}
      .cd-st{display:flex;align-items:center;gap:14px;text-align:left;padding:0;width:100%}
      .cd-dot{margin:0;flex:none}
      .cd-st-label{margin-top:0}
      .cd-lamp{display:none}
      .cd-st-sub{white-space:normal}
    }
  </style>

  {/* ===== 致读者的一封信（拆信交互 · A2 悬念款） ===== */}
  <div class="letter-gap">
    <ReaderLetter />
  </div>

  <style is:global>
    /* ===== Hero 内联搜索（方案 B） ===== */
    .hero-search {
      position: relative;
      max-width: 560px;
      margin: 0 auto;
    }
    .hero-search-box {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 6px 6px 18px;
      border: 2px solid var(--color-border);
      border-radius: 12px;
      background: #fff;
      transition: border-color .2s, box-shadow .2s;
    }
    .hero-search-box:focus-within {
      border-color: var(--color-accent);
      box-shadow: 0 4px 20px rgba(245,80,0,0.12);
    }
    #hero-search-input {
      flex: 1;
      min-width: 0;
      border: none;
      outline: none;
      font-size: 1.05rem;
      padding: 14px 0;
      font-family: inherit;
      color: var(--color-text);
      background: transparent;
    }
    #hero-search-input::placeholder {
      color: var(--color-text-secondary);
    }
    .hero-search-go {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: var(--color-accent);
      color: #fff;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      transition: background .2s, transform .15s;
      flex-shrink: 0;
    }
    .hero-search-go:hover { background: #d94700; transform: scale(1.05); }
    .hero-search-dropdown {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.12);
      overflow: hidden;
      display: none;
      z-index: 50;
      max-height: 52vh;
      overflow-y: auto;
      text-align: left;
    }
    .hero-search-dropdown.show { display: block; }
    .hero-search-dropdown .search-result-item {
      padding: 14px 18px;
    }
    .hero-search-dropdown .search-empty {
      padding: 24px 18px;
      text-align: center;
      color: var(--color-text-secondary);
      font-size: .9rem;
    }
    .hero-search-all {
      display: block;
      padding: 12px 18px;
      text-align: center;
      font-size: 13.5px;
      color: var(--color-accent);
      text-decoration: none;
      border-top: 1px solid var(--color-border);
      background: rgba(245,80,0,0.03);
    }
    .hero-search-all:hover { background: rgba(245,80,0,0.08); }

    /* ===== 移动端专属提醒（桌面隐藏） ===== */
    .mobile-tip {
      display: none;
      text-align: center;
      font-size: 15px;
      font-weight: 600;
      color: var(--color-accent);
      margin: 10px auto 0;
      letter-spacing: 0.02em;
    }
    @media (max-width: 768px) {
      .mobile-tip { display: block; }
    }

    /* ===== 网站地址复制条 ===== */
    .site-url-box {
      display: none;
      align-items: center;
      gap: 10px;
      max-width: 360px;
      margin: 14px auto 0;
      padding: 5px 5px 5px 14px;
      border: 1.5px solid var(--color-border);
      border-radius: 10px;
      background: #fff;
      transition: border-color .2s, box-shadow .2s;
    }
    @media (max-width: 768px) {
      .site-url-box { display: flex; }
    }
    .site-url-box:hover {
      border-color: rgba(245,80,0,.4);
      box-shadow: 0 4px 14px rgba(245,80,0,.08);
    }
    .site-url-text {
      flex: 1;
      min-width: 0;
      font-size: 14px;
      font-weight: 500;
      color: var(--color-text);
      letter-spacing: 0.01em;
      user-select: all;
    }
    .site-url-btn {
      flex-shrink: 0;
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      background: var(--color-accent);
      border: none;
      border-radius: 7px;
      padding: 7px 14px;
      cursor: pointer;
      transition: background .2s, transform .15s;
    }
    .site-url-btn:hover { background: #d94700; transform: translateY(-1px); }
    .site-url-btn.copied { background: #2a9d3c; }

    /* ===== 首页书籍：封面流 · 站点白底 · 完整彩卡（2026-09-29 ① 全融入版） ===== */
    .section-books .section-inner { max-width: 1200px; }
    .section-columns .section-inner { max-width: 1200px; }
    .books-cf { /* 全融入：无面板、直接用页面底色，与全站统一 */ }
    .cf-head { text-align: center; padding: 0 24px; }
    .cf-title {
      font-family: var(--font-serif); font-size: 1.9rem; font-weight: 700;
      color: var(--color-text); letter-spacing: .02em; margin-bottom: 8px;
    }
    .cf-title .hl { color: var(--color-accent); }
    .cf-sub { font-size: .92rem; color: var(--color-text-secondary); margin-bottom: 22px; }
    .cf-wrap { position: relative; height: 486px; margin-top: 30px; overflow-x: clip; }
    .deck-card {
      position: absolute; left: 50%; top: 0; margin-left: -165px;
      width: 330px; height: 440px; border-radius: 16px; overflow: hidden;
      display: flex; flex-direction: column;
      background: var(--color-card-bg, #fff);
      border: 1px solid var(--color-border);
      text-decoration: none; cursor: pointer; color: inherit;
      transform-origin: 50% 100%;
      transition: transform .45s cubic-bezier(.22,.61,.36,1), filter .45s, opacity .45s, box-shadow .45s;
      box-shadow: 0 12px 26px rgba(28,25,23,.10);
    }
    .deck-card.is-center { box-shadow: 0 22px 44px rgba(245,80,0,.18); border-color: rgba(245,80,0,.35); }
