---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ReaderLetter from '../components/ReaderLetter.astro';
import { getCollection } from 'astro:content';
import { columns } from '../data/columns';

const books = await getCollection('books');
const posts = await getCollection('blog');

books.sort((a, b) => a.data.order - b.data.order);

const firstChapterMap = new Map();
const chapterCountMap = new Map();
for (const book of books) {
  const chapters = posts
    .filter(p => p.data.series === book.data.seriesName && p.data.seriesOrder !== undefined)
    .sort((a, b) => (a.data.seriesOrder as number) - (b.data.seriesOrder as number));
  if (chapters.length > 0) {
    firstChapterMap.set(book.id, chapters[0].data.slug);
  }
  chapterCountMap.set(book.id, chapters.length);
}

function getUnit(book) {
  const t = book.data.title || '';
  const s = book.data.subtitle || '';
  if (t.includes('YC') || t.includes('课') || s.includes('讲')) return '讲';
  return '章';
}

function titleWithBrackets(name) {
  /* 只要含中文就加书名号（含 YC 创业课这类中英混排），纯英文书名才不加 */
  return /[一-龥]/.test(name) ? `《${name}》` : name;
}
---

<BaseLayout title="像企业家一样写作">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <h1>Build, sell, write, read, invest, and own.</h1>
      <p class="hero-cn">构建，销售，写作，阅读，投资，掌控——<strong>把这些变成习惯。</strong></p>
      <div class="hero-search">
        <div class="hero-search-box">
          <input id="hero-search-input" type="text" placeholder="我想知道····" autocomplete="off" />
          <button id="hero-search-go" class="hero-search-go" type="button" aria-label="搜索">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
          </button>
        </div>
        <div id="hero-search-dropdown" class="hero-search-dropdown"></div>
      </div>
    </div>
  </section>

  <!-- Books Preview -->
  <section class="section section-books">
    <div class="section-inner">
      <SectionHeader title="书籍作品" icon="book" />
      <div class="books-preview-grid">
        {books.map((book) => {
          const firstChapter = firstChapterMap.get(book.id);
          const chapterCount = chapterCountMap.get(book.id) || 0;
          const unit = getUnit(book);
          const href = firstChapter ? `/blog/${firstChapter}` : '#';
          // 有系列名的书（如《闭环》），首页统一显示「书名：副标题」，避免与书籍页名称不一致
          const title = book.data.seriesName && book.data.subtitle
            ? `${book.data.title}：${book.data.subtitle}`
            : (book.data.seriesName || book.data.title);
          return (
            <a href={href} class="book-card">
              <div class="book-card-cover">
                <img src={book.data.cover} alt={book.data.title} />
              </div>
              <h3>{titleWithBrackets(title)}</h3>
              {book.data.motto && <p class="book-card-hook">{book.data.motto}</p>}
              {chapterCount > 0 && (
                <span class="book-card-cta">{chapterCount} {unit} · 开始阅读 →</span>
              )}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Columns Preview -->
  <section class="section section-columns">
    <div class="section-inner">
      <SectionHeader title="专栏" icon="pen" />
      <div class="columns-preview-grid">
        {columns.map((column) => (
          <div class="column-preview-card">
            <h3>{titleWithBrackets(column.name)}</h3>
            <p class="column-preview-desc">{column.description}</p>
            <div class="column-preview-list">
              {column.issues.slice(0, 3).map((issue) => (
                <a
                  href={issue.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="column-preview-item"
                >
                  <span>第 {issue.issue} 期 · {issue.title}</span>
                  <span>↗</span>
                </a>
              ))}
            </div>
            <a href={`/columns/${column.id}`} class="column-preview-all">
              查看全部 {column.issueCount} 期 →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== 致读者的一封信（拆信交互 · A2 悬念款） ===== */}
  <ReaderLetter />

  <style is:global>
    /* ===== Hero 内联搜索（方案 B） ===== */
    .hero-search {
      position: relative;
      max-width: 560px;
      margin: 0 auto;
    }
    .hero-search-box {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 6px 6px 18px;
      border: 2px solid var(--color-border);
      border-radius: 12px;
      background: #fff;
      transition: border-color .2s, box-shadow .2s;
    }
    .hero-search-box:focus-within {
      border-color: var(--color-accent);
      box-shadow: 0 4px 20px rgba(245,80,0,0.12);
    }
    #hero-search-input {
      flex: 1;
      min-width: 0;
      border: none;
      outline: none;
      font-size: 1.05rem;
      padding: 14px 0;
      font-family: inherit;
      color: var(--color-text);
      background: transparent;
    }
    #hero-search-input::placeholder {
      color: var(--color-text-secondary);
    }
    .hero-search-go {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: var(--color-accent);
      color: #fff;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      transition: background .2s, transform .15s;
      flex-shrink: 0;
    }
    .hero-search-go:hover { background: #d94700; transform: scale(1.05); }
    .hero-search-dropdown {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.12);
      overflow: hidden;
      display: none;
      z-index: 50;
      max-height: 52vh;
      overflow-y: auto;
      text-align: left;
    }
    .hero-search-dropdown.show { display: block; }
    .hero-search-dropdown .search-result-item {
      padding: 14px 18px;
    }
    .hero-search-dropdown .search-empty {
      padding: 24px 18px;
      text-align: center;
      color: var(--color-text-secondary);
      font-size: .9rem;
    }
    .hero-search-all {
      display: block;
      padding: 12px 18px;
      text-align: center;
      font-size: 13.5px;
      color: var(--color-accent);
      text-decoration: none;
      border-top: 1px solid var(--color-border);
      background: rgba(245,80,0,0.03);
    }
    .hero-search-all:hover { background: rgba(245,80,0,0.08); }

    /* ===== 首页书籍卡片（案例 5 · 迷你书店网格） ===== */
    .section-books .section-inner { max-width: 1200px; }
    .section-columns .section-inner { max-width: 1200px; }
    .books-preview-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .book-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 28px 24px;
      background: var(--color-card-bg);
      border: 2px solid rgba(245,80,0,.5);
      border-radius: 14px;
      box-shadow: 0 6px 22px rgba(245,80,0,.10);
      text-decoration: none;
      color: inherit;
      transition: box-shadow .2s, transform .2s, border-color .2s;
    }
    .book-card:hover {
      box-shadow: 0 16px 36px rgba(245,80,0,.22);
      border-color: var(--color-accent);
      transform: translateY(-4px);
    }
    .book-card-cover {
      position: relative;
      width: 120px;
      aspect-ratio: 3/4;
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 18px;
      box-shadow: 0 10px 28px rgba(0,0,0,0.16);
      flex-shrink: 0;
    }
    .book-card-cover img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .book-card h3 {
      font-family: var(--font-serif);
      font-size: 0.98rem;
      font-weight: 600;
      margin-bottom: 6px;
      line-height: 1.45;
    }
    .book-card-hook {
      font-family: var(--font-serif);
      font-size: 13px;
      font-style: italic;
      color: var(--color-accent);
      margin-bottom: 14px;
      line-height: 1.55;
    }
    .book-card-cta {
      display: inline-block;
      font-size: 13px;
      color: #fff;
      background: #1a1a1a;
      border: 1.5px solid #1a1a1a;
      border-radius: 999px;
      padding: 8px 16px;
      font-weight: 600;
      text-decoration: none;
      transition: background .2s, border-color .2s, transform .2s, box-shadow .2s;
    }
    .book-card:hover .book-card-cta {
      background: var(--color-accent);
      border-color: var(--color-accent);
      transform: translateY(-1px);
      box-shadow: 0 6px 14px rgba(245,80,0,.25);
    }

    /* ===== 首页专栏预览卡片（方案 B） ===== */
    .columns-preview-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .column-preview-card {
      background: var(--color-card-bg);
      border: 2px solid rgba(245,80,0,.5);
      border-radius: 14px;
      padding: 26px 24px;
      transition: box-shadow .2s, transform .2s, border-color .2s;
    }
    .column-preview-card:hover {
      box-shadow: 0 12px 30px rgba(245,80,0,.18);
      border-color: var(--color-accent);
      transform: translateY(-2px);
    }
    .column-preview-card h3 {
      font-family: var(--font-serif);
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .column-preview-desc {
      font-size: 13px;
      color: var(--color-text-secondary);
      margin-bottom: 16px;
      line-height: 1.55;
    }
    .column-preview-list {
      border-top: 1px solid var(--color-border);
      margin-bottom: 14px;
    }
    .column-preview-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 11px 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 13px;
      color: var(--color-text-secondary);
      text-decoration: none;
      transition: color .15s;
    }
    .column-preview-item:last-child { border-bottom: none; }
    .column-preview-item:hover { color: var(--color-accent); }
    .column-preview-all {
      display: inline-block;
      font-size: 13px;
      color: #fff;
      background: #1a1a1a;
      border: 1.5px solid #1a1a1a;
      border-radius: 999px;
      padding: 8px 16px;
      font-weight: 600;
      text-decoration: none;
      transition: background .2s, border-color .2s, transform .2s, box-shadow .2s;
    }
    .column-preview-all:hover {
      background: var(--color-accent);
      border-color: var(--color-accent);
      transform: translateY(-1px);
      box-shadow: 0 6px 14px rgba(245,80,0,.25);
      color: #fff;
    }

    @media (max-width: 640px) {
      .hero-search { max-width: 100%; }
      #hero-search-input { font-size: 1rem; padding: 12px 0; }
      .hero-search-go { width: 36px; height: 36px; }
      .hero-search-go svg { width: 16px; height: 16px; }
      .books-preview-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
      .book-card { padding: 20px 14px; }
      .book-card-cover { width: 92px; }
      .book-card h3 { font-size: 1rem; }
      .book-card-hook { font-size: 12px; }
      .book-card-cta { font-size: 12.5px; }
      .columns-preview-grid { grid-template-columns: 1fr; gap: 16px; }
      .column-preview-card { padding: 20px 18px; }
      .column-preview-card h3 { font-size: 1.05rem; }
      .column-preview-desc { font-size: 12px; }
      .column-preview-item { font-size: 12.5px; }
    }
    @media (max-width: 400px) {
      .books-preview-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
