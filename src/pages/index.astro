---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ReaderLetter from '../components/ReaderLetter.astro';
import { getCollection } from 'astro:content';
import { columns } from '../data/columns';

const books = await getCollection('books');
const posts = await getCollection('blog');

books.sort((a, b) => a.data.order - b.data.order);

const firstChapterMap = new Map();
const chapterCountMap = new Map();
for (const book of books) {
  const chapters = posts
    .filter(p => p.data.series === book.data.seriesName && p.data.seriesOrder !== undefined)
    .sort((a, b) => (a.data.seriesOrder as number) - (b.data.seriesOrder as number));
  if (chapters.length > 0) {
    firstChapterMap.set(book.id, chapters[0].data.slug);
  }
  chapterCountMap.set(book.id, chapters.length);
}

function getUnit(book) {
  const t = book.data.title || '';
  const s = book.data.subtitle || '';
  if (t.includes('YC') || t.includes('课') || s.includes('讲')) return '讲';
  return '章';
}

function titleWithBrackets(name) {
  /* 只要含中文就加书名号（含 YC 创业课这类中英混排），纯英文书名才不加 */
  return /[一-龥]/.test(name) ? `《${name}》` : name;
}

---

<BaseLayout title="像企业家一样写作">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <h1>Build, sell, write, read, invest, and own.</h1>
      <p class="hero-cn">构建，销售，写作，阅读，投资，掌控——<strong>把这些变成习惯。</strong></p>
      <div class="hero-search">
        <div class="hero-search-box">
          <input id="hero-search-input" type="text" placeholder="我想知道····" autocomplete="off" />
          <button id="hero-search-go" class="hero-search-go" type="button" aria-label="搜索">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
          </button>
        </div>
        <div id="hero-search-dropdown" class="hero-search-dropdown"></div>
      </div>
      <p class="mobile-tip">（我更希望你在电脑上打开我）</p>
      <div class="site-url-box">
        <span class="site-url-text">gusangciren.github.io</span>
        <button class="site-url-btn" type="button" data-url="gusangciren.github.io">复制</button>
      </div>
    </div>
  </section>

  <!-- Books Preview：封面流 · 站点白底 · /book 同款白卡（2026-09-29 ②） -->
  <section class="section section-books">
    <div class="section-inner">
      <div class="books-cf">
        <div class="cf-head">
          <div class="cf-title">书籍<span class="hl">作品</span></div>
          <div class="cf-sub">我这辈子遇到的聪明人，没有一个不每天阅读的——没有，一个都没有。（查理·芒格）</div>
        </div>
        <div class="cf-wrap" id="books-deck">
          {books.map((book, i) => {
            const slug = book.slug || book.id.replace(/\.(md|mdx)$/i, '');
            const firstChapter = firstChapterMap.get(book.id);
            const chapterCount = chapterCountMap.get(book.id) || 0;
            const unit = getUnit(book);
            const href = firstChapter ? `/blog/${firstChapter}` : `/book/${slug}`;
            const meta = book.data.ongoing ? '连载中' : `${chapterCount} ${unit} · 免费`;
            const fullTitle = titleWithBrackets(book.data.subtitle ? `${book.data.title}：${book.data.subtitle}` : book.data.title);
            return (
              <a href={href} class="deck-card">
                <div class="dc-cover">
                  {book.data.ongoing && <span class="dc-ongoing">持续更新中…</span>}
                  {book.data.isNew && !book.data.ongoing && <span class="dc-new">NEW</span>}
                  <img src={book.data.cover} alt={book.data.title} loading="lazy" onerror="this.classList.add('broken')" />
                </div>
                <div class="dc-body">
                  <div class="dc-title">{fullTitle}</div>
                  <p class="dc-desc">{book.data.description}</p>
                  <div class="dc-foot">
                    <span class="dc-meta">{meta}</span>
                    <span class="dc-go">开始阅读 →</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      document.querySelectorAll('.site-url-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var url = btn.dataset.url;
          function done() {
            btn.classList.add('copied');
            btn.textContent = '已复制';
            setTimeout(function () {
              btn.classList.remove('copied');
              btn.textContent = '复制';
            }, 1500);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(done).catch(function () {
              var input = document.createElement('input');
              input.value = url;
              document.body.appendChild(input);
              input.select();
              document.execCommand('copy');
              document.body.removeChild(input);
              done();
            });
          } else {
            var input = document.createElement('input');
            input.value = url;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            done();
          }
        });
      });
    })();

    (function () {
      var wrap = document.getElementById('books-deck');
      if (!wrap) return;
      var cards = Array.prototype.slice.call(wrap.querySelectorAll('.deck-card'));
      var n = cards.length, center = 0, timer = null;
      var FALL = 0.19; /* 侧卡缩放衰减：d=1 → .81，d=2 → .62 */
      function halfWidth() { return Math.min(1200, window.innerWidth - 48) / 2; }
      /* 桌面/平板：最外侧卡（d=2）右缘正好对齐专栏内容区边缘 */
      function spacing() {
        var half = halfWidth();
        var cw = (cards[0] ? cards[0].offsetWidth : 264) / 2;
        var sp = (half - cw * (1 - 2 * FALL)) / 2;
        return Math.max(150, Math.min(260, sp));
      }
      function render(off) {
        var mobile = window.innerWidth < 640;
        var cw = (cards[0] ? cards[0].offsetWidth : 264) / 2;
        /* 手机：两侧卡探出 ~90px 隐约可见下一本（渐隐遮罩融掉边缘，不露被裁文字），d≥2 隐藏 */
        var PEEK = 90;
        var sp = mobile ? (halfWidth() + cw * 0.88 - PEEK) : spacing();
        var off = off || 0;
        cards.forEach(function (c, i) {
          var d = (i - center + n) % n; if (d > n / 2) d -= n;
          var ad = Math.abs(d);
          var hidden = mobile && ad >= 2;
          var s = mobile ? (ad === 0 ? 1 : 0.88) : 1 - Math.min(ad, 2) * FALL;
          c.style.transform = 'translateX(' + (d * sp + off) + 'px) scale(' + s.toFixed(3) + ')';
          c.style.zIndex = 10 - ad * 2;
          /* 浅底：侧卡淡出到白（降不透明度 + 降饱和），而非压暗 */
          c.style.opacity = hidden ? '0' : (mobile && ad > 0 ? '0.5' : (1 - Math.min(ad, 2) * 0.42).toFixed(2));
          c.style.pointerEvents = hidden ? 'none' : '';
          c.style.filter = ad > 0 ? 'saturate(' + (1 - Math.min(ad, 2) * 0.4).toFixed(2) + ')' : 'none';
          c.classList.toggle('is-center', ad === 0);
        });
      }
      function go(i) { center = ((i % n) + n) % n; render(); }
      var lastDrag = 0;
      cards.forEach(function (c, i) {
        c.addEventListener('click', function (e) {
          if (Date.now() - lastDrag < 400) { e.preventDefault(); return; } /* 刚滑完不误触链接 */
          if (i !== center) { e.preventDefault(); go(i); }
        });
      });
      /* 手机：手指横向滑动切换（实时跟手，松手按阈值吸附；竖向滚动不受影响） */
      var tsX = 0, tsY = 0, dragX = 0, axis = null, dragging = false;
      function setCardTransition(on) {
        cards.forEach(function (c) { c.style.transition = on ? '' : 'none'; });
      }
      wrap.addEventListener('touchstart', function (e) {
        if (window.innerWidth < 640 && e.touches.length === 1) {
          if (timer) { clearInterval(timer); timer = null; }
          tsX = e.touches[0].clientX; tsY = e.touches[0].clientY;
          dragging = true; axis = null; dragX = 0;
        }
      }, { passive: true });
      wrap.addEventListener('touchmove', function (e) {
        if (!dragging) return;
        var dx = e.touches[0].clientX - tsX, dy = e.touches[0].clientY - tsY;
        if (!axis) {
          if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
          axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
        }
        if (axis !== 'x') return;
        e.preventDefault();
        dragX = dx;
        setCardTransition(false);
        render(dragX);
      }, { passive: false });
      function touchEnd() {
        if (!dragging) return;
        dragging = false;
        setCardTransition(true);
        var moved = dragX; dragX = 0;
        if (axis === 'x' && Math.abs(moved) > 40) {
          lastDrag = Date.now();
          go(center + (moved < 0 ? 1 : -1));
        } else {
          render();
        }
        start();
      }
      wrap.addEventListener('touchend', touchEnd);
      wrap.addEventListener('touchcancel', touchEnd);
      wrap.addEventListener('mouseenter', function () { if (timer) { clearInterval(timer); timer = null; } });
      wrap.addEventListener('mouseleave', start);
      function start() { if (!timer) timer = setInterval(function () { go(center + 1); }, 3500); }
      window.addEventListener('resize', render);
      render(); start();
    })();
  </script>

  <!-- Columns Preview -->
  <section class="section section-columns">
    <div class="section-inner">
      <SectionHeader title="专栏" icon="pen" suffix="（持续更新中）" />
      <div class="columns-preview-grid">
        {columns.map((column) => (
          <div class="column-preview-card">
            <h3>{titleWithBrackets(column.name)}</h3>
            <p class="column-preview-desc">{column.description}</p>
            <div class="column-preview-list">
              {column.issues.slice(0, 3).map((issue) => (
                <a
                  href={issue.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="column-preview-item"
                >
                  <span>第 {issue.issue} 期 · {issue.title}</span>
                  <span>↗</span>
                </a>
              ))}
            </div>
            <a
              href={column.albumUrl || `/columns/${column.id}`}
              class="column-preview-all"
              target={column.albumUrl ? '_blank' : undefined}
              rel={column.albumUrl ? 'noopener noreferrer' : undefined}
            >
              阅读合集 →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== 致读者的一封信（拆信交互 · A2 悬念款） ===== */}
  <ReaderLetter />

  <style is:global>
    /* ===== Hero 内联搜索（方案 B） ===== */
    .hero-search {
      position: relative;
      max-width: 560px;
      margin: 0 auto;
    }
    .hero-search-box {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 6px 6px 18px;
      border: 2px solid var(--color-border);
      border-radius: 12px;
      background: #fff;
      transition: border-color .2s, box-shadow .2s;
    }
    .hero-search-box:focus-within {
      border-color: var(--color-accent);
      box-shadow: 0 4px 20px rgba(245,80,0,0.12);
    }
    #hero-search-input {
      flex: 1;
      min-width: 0;
      border: none;
      outline: none;
      font-size: 1.05rem;
      padding: 14px 0;
      font-family: inherit;
      color: var(--color-text);
      background: transparent;
    }
    #hero-search-input::placeholder {
      color: var(--color-text-secondary);
    }
    .hero-search-go {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      background: var(--color-accent);
      color: #fff;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      transition: background .2s, transform .15s;
      flex-shrink: 0;
    }
    .hero-search-go:hover { background: #d94700; transform: scale(1.05); }
    .hero-search-dropdown {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.12);
      overflow: hidden;
      display: none;
      z-index: 50;
      max-height: 52vh;
      overflow-y: auto;
      text-align: left;
    }
    .hero-search-dropdown.show { display: block; }
    .hero-search-dropdown .search-result-item {
      padding: 14px 18px;
    }
    .hero-search-dropdown .search-empty {
      padding: 24px 18px;
      text-align: center;
      color: var(--color-text-secondary);
      font-size: .9rem;
    }
    .hero-search-all {
      display: block;
      padding: 12px 18px;
      text-align: center;
      font-size: 13.5px;
      color: var(--color-accent);
      text-decoration: none;
      border-top: 1px solid var(--color-border);
      background: rgba(245,80,0,0.03);
    }
    .hero-search-all:hover { background: rgba(245,80,0,0.08); }

    /* ===== 移动端专属提醒（桌面隐藏） ===== */
    .mobile-tip {
      display: none;
      text-align: center;
      font-size: 15px;
      font-weight: 600;
      color: var(--color-accent);
      margin: 10px auto 0;
      letter-spacing: 0.02em;
    }
    @media (max-width: 768px) {
      .mobile-tip { display: block; }
    }

    /* ===== 网站地址复制条 ===== */
    .site-url-box {
      display: none;
      align-items: center;
      gap: 10px;
      max-width: 360px;
      margin: 14px auto 0;
      padding: 5px 5px 5px 14px;
      border: 1.5px solid var(--color-border);
      border-radius: 10px;
      background: #fff;
      transition: border-color .2s, box-shadow .2s;
    }
    @media (max-width: 768px) {
      .site-url-box { display: flex; }
    }
    .site-url-box:hover {
      border-color: rgba(245,80,0,.4);
      box-shadow: 0 4px 14px rgba(245,80,0,.08);
    }
    .site-url-text {
      flex: 1;
      min-width: 0;
      font-size: 14px;
      font-weight: 500;
      color: var(--color-text);
      letter-spacing: 0.01em;
      user-select: all;
    }
    .site-url-btn {
      flex-shrink: 0;
      font-size: 13px;
      font-weight: 600;
      color: #fff;
      background: var(--color-accent);
      border: none;
      border-radius: 7px;
      padding: 7px 14px;
      cursor: pointer;
      transition: background .2s, transform .15s;
    }
    .site-url-btn:hover { background: #d94700; transform: translateY(-1px); }
    .site-url-btn.copied { background: #2a9d3c; }

    /* ===== 首页书籍：封面流 · 站点白底 · 完整彩卡（2026-09-29 ① 全融入版） ===== */
    .section-books .section-inner { max-width: 1200px; }
    .section-columns .section-inner { max-width: 1200px; }
    .books-cf { /* 全融入：无面板、直接用页面底色，与全站统一 */ }
    .cf-head { text-align: center; padding: 0 24px; }
    .cf-title {
      font-family: var(--font-serif); font-size: 1.9rem; font-weight: 700;
      color: var(--color-text); letter-spacing: .02em; margin-bottom: 8px;
    }
    .cf-title .hl { color: var(--color-accent); }
    .cf-sub { font-size: .92rem; color: var(--color-text-secondary); margin-bottom: 22px; }
    .cf-wrap { position: relative; height: 392px; margin-top: 30px; overflow-x: clip; }
    .deck-card {
      position: absolute; left: 50%; top: 0; margin-left: -132px;
      width: 264px; height: 352px; border-radius: 14px; overflow: hidden;
      display: flex; flex-direction: column;
      background: var(--color-card-bg, #fff);
      border: 1px solid var(--color-border);
      text-decoration: none; cursor: pointer; color: inherit;
      transform-origin: 50% 100%;
      transition: transform .45s cubic-bezier(.22,.61,.36,1), filter .45s, opacity .45s, box-shadow .45s;
      box-shadow: 0 12px 26px rgba(28,25,23,.10);
    }
    .deck-card.is-center { box-shadow: 0 22px 44px rgba(245,80,0,.18); border-color: rgba(245,80,0,.35); }
    .deck-card img.broken { display: none; }
    .dc-cover {
      position: relative; background: #f7f6f4; height: 176px;
      display: flex; justify-content: center; align-items: flex-start;
      padding-top: 20px; overflow: hidden;
    }
    .dc-cover img {
      width: 104px; aspect-ratio: 3 / 4; object-fit: cover;
      border-radius: 4px; box-shadow: 0 4px 14px rgba(0,0,0,.16);
    }
    .dc-new {
      position: absolute; top: 12px; right: 12px;
      background: var(--color-accent); color: #fff;
      font-size: 10.5px; font-weight: 700; letter-spacing: .08em;
      padding: 3px 9px; border-radius: 999px;
      box-shadow: 0 4px 10px rgba(245,80,0,.3); z-index: 3;
    }
    .dc-ongoing {
      position: absolute; top: 16px; right: -26px; width: 104px; text-align: center;
      transform: rotate(45deg); transform-origin: center center;
      font-size: 10px; font-weight: 600; color: #fff; background: var(--color-accent);
      letter-spacing: .04em; padding: 4px 0;
      box-shadow: 0 2px 6px rgba(0,0,0,.15); z-index: 3; pointer-events: none;
      white-space: nowrap;
    }
    .dc-body { padding: 13px 16px 13px; display: flex; flex-direction: column; flex: 1; min-height: 0; }
    .dc-title {
      font-family: var(--font-serif); font-size: 13px; font-weight: 700; line-height: 1.5;
      text-align: center; margin: 0 0 7px; color: var(--color-text);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .dc-desc {
      font-size: 12px; color: #555; line-height: 1.65; margin: 0;
      display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;
    }
    .dc-foot {
      margin-top: auto; display: flex; justify-content: space-between; align-items: center;
      border-top: 1px solid var(--color-border); padding-top: 10px;
    }
    .dc-meta { font-size: 11.5px; color: var(--color-text-secondary); white-space: nowrap; }
    .dc-go { font-size: 12.5px; color: var(--color-accent); font-weight: 600; white-space: nowrap; }

    /* ===== 首页专栏预览卡片（方案 B） ===== */
    .columns-preview-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .column-preview-card {
      background: var(--color-card-bg);
      border: 2px solid rgba(245,80,0,.5);
      border-radius: 14px;
      padding: 26px 24px;
      transition: box-shadow .2s, transform .2s, border-color .2s;
    }
    .column-preview-card:hover {
      box-shadow: 0 12px 30px rgba(245,80,0,.18);
      border-color: var(--color-accent);
      transform: translateY(-2px);
    }
    .column-preview-card h3 {
      font-family: var(--font-serif);
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .column-preview-desc {
      font-size: 13px;
      color: var(--color-text-secondary);
      margin-bottom: 16px;
      line-height: 1.55;
    }
    .column-preview-list {
      border-top: 1px solid var(--color-border);
      margin-bottom: 14px;
    }
    .column-preview-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 11px 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 13px;
      color: var(--color-text-secondary);
      text-decoration: none;
      transition: color .15s;
    }
    .column-preview-item:last-child { border-bottom: none; }
    .column-preview-item:hover { color: var(--color-accent); }
    .column-preview-all {
      display: inline-block;
      font-size: 13px;
      color: #fff;
      background: #1a1a1a;
      border: 1.5px solid #1a1a1a;
      border-radius: 999px;
      padding: 8px 16px;
      font-weight: 600;
      text-decoration: none;
      transition: background .2s, border-color .2s, transform .2s, box-shadow .2s;
    }
    .column-preview-all:hover {
      background: var(--color-accent);
      border-color: var(--color-accent);
      transform: translateY(-1px);
      box-shadow: 0 6px 14px rgba(245,80,0,.25);
      color: #fff;
    }

    @media (max-width: 640px) {
      .hero-search { max-width: 100%; }
      #hero-search-input { font-size: 1rem; padding: 12px 0; }
      .hero-search-go { width: 36px; height: 36px; }
      .hero-search-go svg { width: 16px; height: 16px; }
      .site-url-box { max-width: 100%; padding: 5px 5px 5px 12px; }
      .site-url-text { font-size: 13.5px; }
      .site-url-btn { font-size: 12.5px; padding: 6px 12px; }
      .cf-title { font-size: 1.4rem; }
      .cf-wrap { height: 306px; }
      /* 手机：两端白色渐隐只收最外 ~44px，侧卡探出的 90px 主体隐约可见（被裁文字融进底色） */
      .cf-wrap::before, .cf-wrap::after {
        content: ''; position: absolute; top: -20px; bottom: -20px; width: 44px;
        z-index: 20; pointer-events: none;
      }
      .cf-wrap::before { left: -26px; background: linear-gradient(90deg, #fafaf9 30%, rgba(250,250,249,0)); }
      .cf-wrap::after { right: -26px; background: linear-gradient(270deg, #fafaf9 30%, rgba(250,250,249,0)); }
      .deck-card { width: 206px; height: 264px; margin-left: -103px; }
      .dc-cover { height: 136px; padding-top: 14px; }
      .dc-cover img { width: 82px; }
      .dc-body { padding: 11px 13px 11px; }
      .dc-title { font-size: 10.5px; }
      .dc-desc { font-size: 11px; -webkit-line-clamp: 2; }
      .dc-meta { font-size: 10.5px; }
      .dc-go { font-size: 11.5px; }
