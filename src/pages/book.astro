---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const books = await getCollection('books');
const posts = await getCollection('blog');

books.sort((a, b) => a.data.order - b.data.order);

const firstChapterMap = new Map();
const chapterCountMap = new Map();
for (const book of books) {
  const chapters = posts
    .filter(p => p.data.series === book.data.seriesName && p.data.seriesOrder !== undefined)
    .sort((a, b) => (a.data.seriesOrder as number) - (b.data.seriesOrder as number));
  if (chapters.length > 0) {
    firstChapterMap.set(book.id, chapters[0].data.slug);
  }
  chapterCountMap.set(book.id, chapters.length);
}

function getUnit(book: (typeof books)[number]) {
  const t = book.data.title || '';
  const s = book.data.subtitle || '';
  if (t.includes('YC') || t.includes('课') || s.includes('讲')) return '讲';
  return '章';
}

function titleWithBrackets(name: string) {
  return /^[A-Za-z]/.test(name) ? name : `《${name}》`;
}
---

<BaseLayout
  title="书籍 — 像企业家一样写作"
  description="三本免费在线读完的书：《选择改变命运》《闭环：第一个100块七步曲》《YC 创业课》——完整章节、金句摘录与实操方法，打开即读，无需注册。"
>
  <div class="book-page">
    <div class="books-header">
      <h1>书籍</h1>
      <p>三本可以直接在站内读完的书。不用注册，不用付费，点开就能读。</p>
    </div>

    {books.map((book) => {
      const slug = book.id.replace(/\.(md|mdx)$/i, '');
      const firstChapter = firstChapterMap.get(book.id);
      const chapterCount = chapterCountMap.get(book.id) || 0;
      const unit = getUnit(book);
      const href = firstChapter ? `/blog/${firstChapter}` : '#';
      return (
        <section class="book-deep" id={slug}>
          <div class="bd-cover">
            <img src={book.data.cover} alt={book.data.title} />
          </div>

          <div class="bd-body">
            <h2>{titleWithBrackets(book.data.title)}</h2>
            <p class="bd-sub">
              {book.data.subtitle}
              {chapterCount > 0 && <span class="bd-count"> · {chapterCount} {unit}</span>}
            </p>

            {book.data.motto && <p class="bd-motto">{book.data.motto}</p>}

            <p class="bd-desc">{book.data.description}</p>

            {book.data.forWho && (
              <p class="bd-forwho"><span>适合谁读</span>{book.data.forWho}</p>
            )}

            {book.data.benefits && book.data.benefits.length > 0 && (
              <ul class="bd-benefits">
                {book.data.benefits.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}

            {firstChapter ? (
              <a href={href} class="bd-cta">免费读完 →</a>
            ) : (
              <span class="bd-cta disabled">即将上线</span>
            )}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>

<style is:global>
  .book-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 100px 24px 80px;
  }
  .books-header {
    text-align: center;
    margin-bottom: 44px;
  }
  .books-header h1 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .books-header p {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  /* ===== 深度卡 ===== */
  .book-deep {
    display: flex;
    gap: 28px;
    align-items: flex-start;
    padding: 30px 28px;
    margin-bottom: 24px;
    background: var(--color-card-bg, #fff);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    transition: box-shadow .2s, transform .2s;
  }
  .book-deep:hover {
    box-shadow: 0 10px 30px rgba(0,0,0,.06);
    transform: translateY(-2px);
  }
  .bd-cover {
    flex: none;
    width: 130px;
    aspect-ratio: 3/4;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 10px 26px rgba(0,0,0,.16);
  }
  .bd-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bd-body { flex: 1; min-width: 0; }
  .bd-body h2 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 4px;
  }
  .bd-sub {
    font-size: 13.5px;
    color: var(--color-accent);
    font-weight: 600;
    margin: 0 0 14px;
  }
  .bd-count { color: var(--color-text-secondary); font-weight: 500; }

  .bd-motto {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    color: #555;
    font-style: italic;
    border-left: 3px solid var(--color-accent);
    padding: 2px 0 2px 12px;
    margin: 0 0 14px;
    line-height: 1.6;
  }

  .bd-desc {
    font-size: 14px;
    color: #555;
    line-height: 1.8;
    margin: 0 0 14px;
  }

  .bd-forwho {
    font-size: 13px;
    color: var(--color-text-secondary);
    margin: 0 0 14px;
    line-height: 1.6;
  }
  .bd-forwho span {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--color-accent);
    background: rgba(245,80,0,.07);
    border-radius: 4px;
    padding: 2px 8px;
    margin-right: 8px;
    vertical-align: 1px;
  }

  .bd-benefits {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
  }
  .bd-benefits li {
    position: relative;
    font-size: 13.5px;
    line-height: 1.6;
    padding: 4px 0 4px 22px;
    color: #333;
  }
  .bd-benefits li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    width: 12px;
    height: 2px;
    background: var(--color-accent);
  }

  .bd-cta {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    font-size: 13.5px;
    font-weight: 600;
    padding: 10px 24px;
    border-radius: 10px;
    text-decoration: none;
    transition: background .2s, transform .15s;
  }
  .bd-cta:hover {
    background: #d94500;
    transform: translateY(-1px);
  }
  .bd-cta.disabled {
    background: #f0f0f0;
    color: #aaa;
    cursor: default;
  }

  @media (max-width: 700px) {
    .book-page { padding: 80px 16px 60px; }
    .book-deep {
      flex-direction: column;
      align-items: center;
      padding: 24px 20px;
      text-align: left;
    }
    .bd-cover { width: 118px; }
    .bd-body h2 { font-size: 1.2rem; }
  }
</style>
