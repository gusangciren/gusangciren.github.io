---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const books = await getCollection('books');
const posts = await getCollection('blog');

books.sort((a, b) => a.data.order - b.data.order);

const firstChapterMap = new Map();
const chapterCountMap = new Map();
for (const book of books) {
  const chapters = posts
    .filter(p => p.data.series === book.data.seriesName && p.data.seriesOrder !== undefined)
    .sort((a, b) => (a.data.seriesOrder as number) - (b.data.seriesOrder as number));
  if (chapters.length > 0) {
    firstChapterMap.set(book.id, chapters[0].data.slug);
  }
  chapterCountMap.set(book.id, chapters.length);
}

function getUnit(book: (typeof books)[number]) {
  const t = book.data.title || '';
  const s = book.data.subtitle || '';
  if (t.includes('YC') || t.includes('课') || s.includes('讲')) return '讲';
  return '章';
}

function titleWithBrackets(name: string) {
  /* 只要含中文就加书名号（含 YC 创业课这类中英混排），纯英文书名才不加 */
  return /[一-龥]/.test(name) ? `《${name}》` : name;
}
---

<BaseLayout
  title="书籍 — 像企业家一样写作"
  description="三本免费在线读完的书：《选择改变命运》《闭环：在你睡觉时赚钱》《YC 创业课》——完整章节、金句摘录与实操方法，打开即读，无需注册。"
>
  <div class="book-page">
    <div class="books-header">
      <h1>书籍</h1>
      <p>三本可以直接在站内读完的书。不用注册，不用付费，点开就能读。</p>
    </div>

    <div class="book-grid">
      {books.map((book) => {
        const slug = book.id.replace(/\.(md|mdx)$/i, '');
        const firstChapter = firstChapterMap.get(book.id);
        const chapterCount = chapterCountMap.get(book.id) || 0;
        const unit = getUnit(book);
        const href = firstChapter ? `/blog/${firstChapter}` : '#';
        const title = titleWithBrackets(
          book.data.subtitle ? `${book.data.title}：${book.data.subtitle}` : book.data.title
        );
        const meta = chapterCount > 0 ? `${chapterCount} ${unit} · 免费` : '免费读完';
        return (
          <a class="book-card" href={href}>
            <div class="bc-cover">
              <img src={book.data.cover} alt={book.data.title} />
            </div>
            <div class="bc-body">
              <h2 class="bc-title">{title}</h2>
              <p class="bc-desc">{book.data.description}</p>
              <div class="bc-foot">
                <span class="bc-meta">{meta}</span>
                <span class="bc-go">开始阅读 →</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style is:global>
  .book-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 100px 24px 80px;
  }
  .books-header {
    text-align: center;
    margin-bottom: 44px;
  }
  .books-header h1 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .books-header p {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  /* ===== 三栏轻卡片网格 ===== */
  .book-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .book-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-card-bg, #fff);
    text-decoration: none;
    color: inherit;
    transition: box-shadow .2s, transform .2s;
  }
  .book-card:hover {
    box-shadow: 0 12px 32px rgba(0,0,0,.07);
    transform: translateY(-3px);
  }

  .bc-cover {
    background: #f7f6f4;
    padding: 22px 18px 0;
    display: flex;
    justify-content: center;
  }
  .bc-cover img {
    width: 58%;
    max-width: 140px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: 0 4px 14px rgba(0,0,0,.16);
  }

  .bc-body {
    padding: 16px 18px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .bc-title {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
    width: 100%;
    margin: 0 0 8px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 3em;
  }
  .bc-desc {
    font-size: 0.85rem;
    color: #555;
    line-height: 1.65;
    margin: 0 0 12px;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bc-foot {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--color-border);
    padding-top: 11px;
  }
  .bc-meta {
    font-size: 12px;
    color: var(--color-text-secondary);
  }
  .bc-go {
    font-size: 13px;
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .book-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .book-page { padding: 80px 16px 60px; }
    .book-grid { grid-template-columns: 1fr; max-width: 360px; margin: 0 auto; }
    .bc-cover img { width: 50%; }
  }
</style>
