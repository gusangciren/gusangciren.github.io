---
import BaseLayout from '../layouts/BaseLayout.astro';
import { columns } from '../data/columns';

function pad(n: number) {
  return n < 10 ? '0' + n : String(n);
}
---

<BaseLayout title="专栏 — 像企业家一样写作">
  <div class="columns-page">
    <div class="columns-header">
      <h1>专栏</h1>
      <p>点击任意一期，直达微信公众号原文阅读</p>
    </div>

    {columns.map((column) => (
      <section class="column-section" id={column.id}>
        <div class="col-head">
          <div class="col-head-left">
            <h2>{column.name}</h2>
            <p>{column.issueCount} 期 · {column.description}</p>
          </div>
          {column.albumUrl ? (
            <a class="album-btn" href={column.albumUrl} target="_blank" rel="noopener noreferrer">
              微信合集 ↗
            </a>
          ) : (
            <span class="album-btn disabled">暂无合集</span>
          )}
        </div>

        <div class="column-list">
          {column.issues.map((issue) => (
            <a
              href={issue.url}
              target="_blank"
              rel="noopener noreferrer"
              class="column-list-item"
            >
              <span class="issue-badge">{pad(issue.issue)}</span>
              <span class="column-item-title">{issue.title}</span>
              <span class="column-go">微信阅读 ↗</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style is:global>
  .columns-page {
    max-width: 760px;
    margin: 0 auto;
    padding: 100px 24px 80px;
  }
  .columns-header {
    text-align: center;
    margin-bottom: 44px;
  }
  .columns-header h1 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .columns-header p {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .column-section {
    margin-bottom: 52px;
  }

  /* 专栏信息卡 + 合集入口 */
  .col-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 16px 18px;
    margin-bottom: 14px;
    background: var(--color-card-bg, #fff);
  }
  .col-head-left h2 {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 4px;
  }
  .col-head-left p {
    margin: 0;
    font-size: 12.5px;
    color: var(--color-text-secondary);
  }
  .album-btn {
    flex-shrink: 0;
    font-size: 12.5px;
    font-weight: 600;
    color: #fff;
    background: var(--color-accent);
    padding: 7px 14px;
    border-radius: 20px;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity .2s;
  }
  .album-btn:hover { opacity: .88; }
  .album-btn.disabled {
    background: #f0f0f0;
    color: #aaa;
  }

  /* 期号徽章列表 */
  .column-list {
    border-top: 1px solid var(--color-border);
  }
  .column-list-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 4px;
    border-bottom: 1px solid #f2f2f2;
    text-decoration: none;
    color: inherit;
    transition: background .15s;
  }
  .column-list-item:hover {
    background: rgba(245,80,0,.05);
  }
  .issue-badge {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: rgba(245,80,0,.08);
    color: var(--color-accent);
    font-size: 12.5px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
  }
  .column-item-title {
    flex: 1;
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.5;
  }
  .column-go {
    flex: none;
    font-size: 12.5px;
    color: var(--color-text-secondary);
    transition: color .15s;
  }
  .column-list-item:hover .column-go {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .columns-page { padding: 80px 16px 60px; }
    .columns-header h1 { font-size: 1.55rem; }
    .col-head { padding: 14px; }
    .col-head-left h2 { font-size: 0.98rem; }
    .column-list-item { gap: 10px; padding: 11px 2px; }
    .issue-badge { width: 30px; height: 30px; font-size: 11.5px; }
    .column-item-title { font-size: 13.5px; }
    .column-go { display: none; }
  }
</style>
