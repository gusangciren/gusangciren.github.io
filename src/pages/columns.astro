---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { columns } from '../data/columns';

function pad(n: number) {
  return n < 10 ? '0' + n : String(n);
}

function findIssue(column: (typeof columns)[number], n: number) {
  return column.issues.find((i) => i.issue === n);
}
---

<BaseLayout
  title="专栏 — 像企业家一样写作"
  description="两个长期更新的专栏：UAC 周刊（57 期）与《像企业家一样写作》（19 期）。按主题策展，从最值得读的那一期开始。"
>
  <div class="columns-page">
    <SectionHeader title="专栏" icon="pen" />

    {/* ===== 付费合集入口 ===== */}
    <div class="bundle-bar">
      <div class="bundle-txt">
        <b>买一次，两样都得到</b>
        <span>
          UAC 周刊 与《写作并变现：像企业家一样写作》打包在<b>同一个付费合集</b>里——一次购买，两个专栏全部解锁。
        </span>
      </div>
      <a class="btn" href={columns.find((c) => c.albumUrl)?.albumUrl} target="_blank" rel="noopener noreferrer">
        查看付费合集 ↗
      </a>
    </div>

    {/* ===== 双栏专栏详情 ===== */}
    <div class="col-grid">
      {columns.map((column, idx) => {
        const latest = column.issues[0];
        return (
          <section class="col-block" id={column.id}>
            {/* 专栏头部 */}
            <div class="col-hero">
              <div class="col-hero-top">
                <span class="col-num">{idx + 1}）</span>
                <h2>{column.name}</h2>
              </div>
              <p class="claim">{column.claim}</p>
              <div class="proof">
                <span class="stat"><b>{column.issueCount}</b> 期连载</span>
                <span class="desc">{column.description}</span>
              </div>
              <div class="hero-actions">
                <a class="btn" href={latest.url} target="_blank" rel="noopener noreferrer">
                  读最新一期 →
                </a>
              </div>
            </div>

            {/* 编辑精选 */}
            <div class="sec">
              <div class="sec-label">从这 3 篇开始</div>
              <div class="feat">
                {column.featured.map((f) => {
                  const it = findIssue(column, f.issue);
                  return (
                    it && (
                      <a
                        class="feat-card"
                        href={it.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <div class="n">第 {f.issue} 期</div>
                        <div class="t">{it.title}</div>
                        <div class="v">{f.value}</div>
                      </a>
                    )
                  );
                })}
              </div>
            </div>

            {/* 主题分组 */}
            <div class="sec">
              <div class="sec-label">按主题读</div>
              {column.groups.map((g) => (
                <div class="grp">
                  <div class="grp-head">
                    <h3>{g.name}</h3>
                    <span class="c">{g.issues.length} 篇</span>
                  </div>
                  {g.issues.map((n) => {
                    const it = findIssue(column, n);
                    return (
                      it && (
                        <a
                          class="grp-row"
                          href={it.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <span class="badge">{pad(n)}</span>
                          <span class="t">{it.title}</span>
                          <span class="go">微信阅读 ↗</span>
                        </a>
                      )
                    );
                  })}
                </div>
              ))}
            </div>

            {/* 底部 CTA */}
            <div class="cta-bar">
              <p>共 {column.issueCount} 期 · 往期全部可直接阅读</p>
              <a
                class="btn"
                href={column.albumUrl || latest.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {column.albumUrl ? '在微信中看全部 →' : '开始阅读 →'}
              </a>
            </div>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style is:global>
  .columns-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 100px 24px 80px;
  }

  /* 付费合集入口 */
  .bundle-bar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 18px 26px;
    background: rgba(245,80,0,.06);
    border: 1px solid rgba(245,80,0,.18);
    border-radius: 16px;
    margin-bottom: 40px;
  }
  .bundle-txt {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .bundle-txt b {
    font-size: 14px;
    color: var(--color-accent);
  }
  .bundle-txt span {
    font-size: 12.5px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .bundle-txt span b { font-size: 12.5px; }

  /* 双栏容器 */
  .col-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    align-items: start;
  }

  /* 单个专栏块 */
  .col-block {
    border: 1.5px solid rgba(245,80,0,.22);
    border-radius: 18px;
    overflow: hidden;
    background: var(--color-card-bg, #fff);
    box-shadow: 0 12px 34px rgba(0,0,0,.07);
  }

  .btn {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 22px;
    text-decoration: none;
    transition: opacity .2s;
  }
  .btn:hover { opacity: .88; }
  .btn.ghost {
    background: #fff;
    color: var(--color-accent);
    border: 1.5px solid var(--color-accent);
  }

  /* 头部 */
  .col-hero {
    padding: 30px 28px 26px;
    border-bottom: 1px solid var(--color-border);
  }
  .col-hero-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .col-num {
    flex: none;
    display: inline-flex;
    align-items: center;
    font-family: var(--font-serif);
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-accent);
  }
  .col-hero h2 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
  }
  .col-hero .claim {
    font-size: 1rem;
    color: #333;
    line-height: 1.85;
    margin: 0 0 16px;
  }
  .proof {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 18px;
    padding: 12px 16px;
    background: rgba(245, 80, 0, 0.06);
    border-radius: 10px;
  }
  .proof .stat {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    font-size: 12.5px;
    color: var(--color-text-secondary);
  }
  .proof b {
    color: var(--color-accent);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
  }
  .proof .desc {
    position: relative;
    padding-left: 14px;
    font-size: 12.5px;
    color: var(--color-text-secondary);
  }
  .proof .desc::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 12px;
    background: var(--color-border);
  }
  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  /* 区块 */
  .sec {
    padding: 26px 28px;
    border-bottom: 1px solid var(--color-border);
  }
  .sec-label {
    font-size: 11px;
    letter-spacing: .12em;
    color: var(--color-text-secondary);
    font-weight: 700;
    margin-bottom: 14px;
  }

  /* 精选 */
  .feat {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .feat-card {
    display: block;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 16px 15px;
    text-decoration: none;
    color: inherit;
    transition: all .18s;
  }
  .feat-card:hover {
    border-color: var(--color-accent);
    background: rgba(245,80,0,.03);
    transform: translateY(-2px);
  }
  .feat-card .n {
    font-size: 11.5px;
    color: var(--color-accent);
    font-weight: 700;
  }
  .feat-card .t {
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.45;
    margin: 6px 0 6px;
  }
  .feat-card .v {
    font-size: 12px;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  /* 分组 */
  .grp { margin-bottom: 22px; }
  .grp:last-child { margin-bottom: 0; }
  .grp-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 6px;
  }
  .grp-head h3 {
    margin: 0;
    font-size: 14.5px;
    font-weight: 600;
    font-family: var(--font-serif);
  }
  .grp-head .c {
    font-size: 12px;
    color: var(--color-text-secondary);
  }
  .grp-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 2px;
    border-top: 1px solid #f2f2f2;
    text-decoration: none;
    color: inherit;
    transition: background .15s;
  }
  .grp-row:hover { background: rgba(245,80,0,.04); }
  .badge {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    background: rgba(245,80,0,.08);
    color: var(--color-accent);
    font-size: 11.5px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
  }
  .grp-row .t {
    flex: 1;
    font-size: 13.5px;
    line-height: 1.5;
  }
  .grp-row .go {
    flex: none;
    font-size: 11.5px;
    color: #ccc;
    transition: color .15s;
  }
  .grp-row:hover .go { color: var(--color-accent); }

  /* CTA */
  .cta-bar {
    padding: 24px 28px;
    background: var(--color-bg, #fafaf9);
    text-align: center;
  }
  .cta-bar p {
    margin: 0 0 12px;
    font-size: 13.5px;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .col-grid { grid-template-columns: 1fr; gap: 28px; }
    .feat { grid-template-columns: 1fr; }
    .grp-row .go { display: none; }
  }
  @media (max-width: 640px) {
    .columns-page { padding: 80px 16px 60px; }
    .bundle-bar { grid-template-columns: 1fr; gap: 14px; padding: 16px 18px; }
    .col-hero { padding: 24px 18px 20px; }
    .col-hero h2 { font-size: 1.3rem; }
    .col-hero-top { gap: 10px; margin-bottom: 8px; }
    .col-num { font-size: 1.8rem; }
    .sec { padding: 20px 18px; }
  }
</style>
