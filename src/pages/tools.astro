<BaseLayout title="工具箱 · 像企业家一样写作">
  <div class="tools-layout">
    <aside class="side">
      <div class="side-title">工具箱</div>
      <ul id="side-menu">
        <li data-pane="pane-write"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></span><span class="lab">书写伙伴</span></li>
        <li data-pane="pane-cover" class="active"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></span><span class="lab">公众号封面</span></li>
        <li data-pane="pane-quote"><span class="ic"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 7h5v6H8.5C8.5 16 11 18 14 18v2c-5 0-9-3-9-9Zm9 0h5v6h-3.5C17.5 16 20 18 23 18v2c-5 0-9-3-9-9Z"/></svg></span><span class="lab">句子卡片</span></li>
      </ul>
    </aside>

    <main class="workspace">
      <button class="side-handle" id="sideToggle" type="button" aria-label="收起侧边栏" aria-expanded="true" title="收起侧边栏（Ctrl+G）" data-tip="收起侧边栏 · Ctrl+G">
        <svg class="chev" width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="10 3 4 8 10 13"></polyline>
        </svg>
        <span class="lbl">工具箱</span>
      </button>
      <!-- 1) 公众号封面制作 -->
      <section class="pane" id="pane-cover">
        <div class="cover-editor">
          <!-- 预览列 -->
          <div class="pv-col">
            <div class="cv-wrap" id="wrap90"><!-- cover90 --></div>

            <p class="pv-tip"><b>拿到图片：</b>点「下载图片」直接下高清图，公众号后台上传即可；或点「复制图片」后 Ctrl+V 粘贴。<br>封面文案<b>直接在卡片上写</b>；想让某词橙红加粗，用 <b>**文字**</b> 包住（如 <b>**价值**</b>），写完后点一下别处高亮即生效。</p>
          </div>

          <!-- 设置区（封面下方 · 全宽三栏网格） -->
          <div class="set-col">
            <div class="set-group composer">
              <div class="cmp-cell">
                <span class="fld-label">边框颜色</span>
                <div class="fr-dots" id="seg-frame">
                  <button class="fr-dot c-red on" data-v="#F53F3F" title="红" aria-label="红"></button>
                  <button class="fr-dot c-ora" data-v="#F55000" title="橙" aria-label="橙"></button>
                  <button class="fr-dot c-none" data-v="" title="无">无</button>
                </div>
                <span class="fld-label" style="margin-top:14px">版式 · 一键换排版</span>
                <div class="lay-seg" id="seg-layout">
                  <button class="lay-btn on" data-l="a" title="经典：大字居左、垂直居中">经典</button>
                  <button class="lay-btn" data-l="b" title="居中：标题与落款全部居中">居中</button>
                </div>
                <div class="cv-ex-row">
                  <button class="ex-btn copy" data-t="90">复制图片</button>
                  <button class="ex-btn dl" data-t="90">下载图片</button>
                </div>
              </div>

              <div class="cmp-cell">
                <span class="fld-label">品牌行</span>
                <div class="brand-line">
                  <label class="tg"><input type="checkbox" id="tg-avatar" checked/><span class="sw"></span><span class="tl">头像</span></label>
                  <button id="btn-avatar" class="avatar-btn" title="上传头像图片">
                    <img id="avatar-thumb" src="/images/logo-180x180.png" alt="头像"/>
                    <span>上传头像</span>
                  </button>
                  <input type="file" id="f-avatar" accept="image/*" hidden/>
                </div>
                <div class="brand-line">
                  <label class="tg"><input type="checkbox" id="tg-name" checked/><span class="sw"></span><span class="tl">名称</span></label>
                  <input id="f-name" class="inp name-inp" type="text" maxlength="14" value="像企业家一样写作"/>
                </div>
                <div class="brand-line">
                  <span class="tl" style="min-width:42px">网站</span>
                  <input id="f-url" class="inp url-inp" type="text" maxlength="40" value="gusangciren.github.io" placeholder="你的网站（选填，不填则不显示）"/>
                </div>
                <div class="cmp-hint">头像 / 名称全关时，品牌行整体收起；上传的头像本机记住，下次不用重传。</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 离屏导出舞台（原生尺寸，避免缩放干扰 html2canvas；放在 pane 内以复用作用域样式） -->
        <div id="export-stage"></div>
      </section>

      <!-- 2) 句子卡片制作（推文截图风 · 双栏工作台） -->
      <section class="pane" id="pane-quote" hidden>
        <div class="ws">
          <!-- 左：画布（预览区） -->
          <div class="canvas">
            <div class="canvas-dot">
              <div class="card-fit" id="qcFit">
              <div class="tcard v-light r34" id="qcCard">
                <span class="t-glow" aria-hidden="true"></span>
                <div class="t-head" id="qcHead">
                  <div class="t-ava" id="qcAva"><span class="ph">人</span></div>
                  <div class="t-id">
                    <div class="t-namerow">
                      <span class="t-name" id="qcName">古思</span>
                      <span class="t-check" id="qcCheck"><svg viewBox="0 0 24 24"><path d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81C14.67 2.63 13.43 1.75 12 1.75s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81S3.56 7.27 4.03 8.66C2.72 9.33 1.85 10.57 1.85 12s.87 2.67 2.18 3.34c-.47 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.66 2.19-1.9 2.19-3.34zm-11.71 4.2L6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z"/></svg></span>
                    </div>
                    <div class="t-handle" id="qcHandle">@Gusang</div>
                  </div>
                </div>
                <div class="t-text" id="qcText" contenteditable="true" spellcheck="false" data-ph="今天想分享什么？"></div>
              </div>
              </div>
            </div>
          </div>

          <!-- 右：属性 -->
          <aside class="props">
            <div class="field">
              <label class="fld-label">卡片尺寸</label>
              <div class="seg" id="qcSize">
                <button class="seg-btn on" data-r="r34">3:4 竖版</button>
                <button class="seg-btn" data-r="r11">1:1 方形</button>
              </div>
            </div>
            <div class="field">
              <label class="fld-label">风格</label>
              <div class="seg" id="qcStyle">
                <button class="seg-btn on" data-v="v-light">亮白</button>
                <button class="seg-btn" data-v="v-dark">纯黑</button>
                <button class="seg-btn" data-v="v-paper">暖纸</button>
                <button class="seg-btn" data-v="v-brand">深色</button>
              </div>
            </div>
            <div class="field">
              <label class="fld-label">灵感</label>
              <button class="btn sm" id="qcDice" style="width:100%" data-quotes={JSON.stringify(diceQuotes)}>🎲 随机一句</button>
            </div>
            <div class="field">
              <label class="fld-label">头像</label>
              <div class="ava-row">
                <div class="ava-prev" id="qcAvaPrev"><span>人</span></div>
                <div class="ava-btns">
                  <button class="btn sm" id="qcAvaUp">上传头像</button>
                  <button class="btn sm" id="qcAvaClr" style="display:none">移除</button>
                </div>
              </div>
              <input type="file" id="qcAvaFile" accept="image/*" hidden />
              <div class="cmp-hint">头像和名字自动记住，下次不用重传。</div>
            </div>
            <div class="field">
              <label class="fld-label">名字</label>
              <input type="text" id="qcName-in" class="f-input" value="古思" placeholder="显示名称" />
            </div>
            <div class="field">
              <label class="fld-label">Handle</label>
              <input type="text" id="qcHandle-in" class="f-input" value="@Gusang" placeholder="@username" />
            </div>
            <div class="field">
              <label class="check-row"><input type="checkbox" id="qcCheck-in" checked /> 显示认证徽章</label>
            </div>
            <div class="export">
              <div class="export-row">
                <button class="btn primary big" id="qcCopy">复制图片</button>
                <button class="btn big" id="qcDown">下载图片</button>
              </div>
              <a class="btn qc-art" href="https://mp.weixin.qq.com/s/w786NBLYHBsjUcu165zZBQ" target="_blank" rel="noopener">推荐文章</a>
              <div class="qc-art-note">每次一句话，就可以写文章/书。</div>
            </div>
          </aside>
        </div>
        <div id="qc-stage"></div>
        <div class="toast" id="qcToast"></div>
      </section>

      <!-- 3) 书写伙伴（白噪音 + 专注时间 + 即时排版） -->
      <section class="pane" id="pane-write" hidden>
        <div class="wp-wrap">
          <div class="wp-hero" id="wpPlayer">
            <div class="wp-row1">
              <div class="wp-left">
                <button class="wp-play" id="wpPlay">▶</button>
                <div class="wp-title" id="wpTitle">耀斑 · 25 分钟专注</div>
              </div>
              <b class="wp-remain" id="wpRemain">25:00</b>
              <div class="wp-timer">
                <svg class="wp-clock" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" fill="none" stroke="rgba(245,234,217,.35)" stroke-width="2"/>
                  <line id="wpHand" x1="12" y1="12" x2="12" y2="4.5" stroke="#F55000" stroke-width="2.4" stroke-linecap="round" transform="rotate(0 12 12)"/>
                </svg>
                <span class="wp-durbox" id="wpDur">25 分钟</span>
              </div>
            </div>
            <div class="wp-bar"><i id="wpFill"></i></div>
            <div class="wp-row2">
              <span id="wpSoundSeg">
                <button class="wp-chip on" data-sound="forest">耀斑</button>
                <button class="wp-chip" data-sound="rain">静默之重</button>
                <button class="wp-chip" data-sound="music">吉他二重奏</button>
              </span>
              <span class="wp-sep"></span>
              <span id="wpDurSeg">
                <button class="wp-chip on" data-dur="25">25 分钟</button>
                <button class="wp-chip" data-dur="50">50 分钟</button>
              </span>
              <button class="wp-focus" id="wpFocus" title="全屏专注写作（Esc 退出）">⛶ 专注模式</button>
              <button class="wp-reset" id="wpReset">↺ 重置</button>
            </div>
          </div>

          <div class="wp-paper">
            <div id="wpEditor"></div>
            <div class="wp-foot">
              <button class="wp-copymd start" id="wpStart" title="清空示例，一键开始记录">马上写一篇</button>
              <button class="wp-copymd ghost" id="wpCopyHtml">复制 HTML</button>
              <button class="wp-copymd ghost" id="wpCopyMd">复制 Markdown</button>
              <span class="wp-wc" id="wpWc">0 字</span>
            </div>
          </div>
        </div>
      </section>

      <div class="tools-toast" id="toolsToast"></div>

    </main>
  </div>

  <script is:inline>
    (function () {
      // ===== 侧边栏切换 =====
      var menu = document.getElementById('side-menu');
      menu.querySelectorAll('li[data-pane]').forEach(function (li) {
        li.addEventListener('click', function () {
          menu.querySelectorAll('li[data-pane]').forEach(function (x) { x.classList.remove('active'); });
          li.classList.add('active');
          document.querySelectorAll('.pane').forEach(function (p) { p.hidden = p.id !== li.dataset.pane; });
          window.dispatchEvent(new Event('resize'));
        });
      });
    })();

      // ===== 全局轻提示（toast）：复制 / 导出 / 保存等反馈统一走这里 =====
      function gToast(msg) {
        var t = document.getElementById('toolsToast'); if (!t) return;
        t.textContent = msg; t.classList.add('show'); clearTimeout(t._t);
        t._t = setTimeout(function () { t.classList.remove('show'); }, 1900);
      }

      // ===== 导出字体（金句 + 封面共用）：全字库子集文楷 → data URI 注入。
      // html2canvas 克隆 iframe 里的网络字体有渲染竞态（导出偶发变黑体），
      // 改用 jsDelivr 上 font-store 子集 woff2（CORS *）转 base64 内联，
      // 克隆文档内字体解码无网络等待，导出字体稳定。
      var exportFontCssPromise = null;
      function getExportFontCss() {
        if (!exportFontCssPromise) {
          exportFontCssPromise = fetch('https://cdn.jsdelivr.net/gh/gusangciren/gusangciren.github.io@source/font-store/WenKaiSubset-Regular.woff2')
            .then(function (r) { if (!r.ok) throw 0; return r.arrayBuffer(); })
            .then(function (buf) {
              var bytes = new Uint8Array(buf), bin = '';
              for (var i = 0; i < bytes.length; i += 0x8000) {
                bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
              }
              return '@font-face{font-family:"WenKai Export";src:url(data:font/woff2;base64,' + btoa(bin) + ') format("woff2");}' +
                '#qc-stage,#qc-stage *,#export-stage,#export-stage *{font-family:"WenKai Export","LXGW WenKai",serif !important;}';
            })
            .catch(function () { return ''; });
        }
        return exportFontCssPromise;
      }

      // ===== 句子卡片工具（推文截图风 · 双栏工作台） =====
      (function () {
        var BG = { 'v-light': '#ffffff', 'v-dark': '#000000', 'v-paper': '#f7f3ec', 'v-brand': '#1c1917' };
        var state = { scheme: 'v-light', ratio: 'r34', text: '', name: '', handle: '', check: true, avatar: '/images/logo-180x180.png' };

        var $ = function (s) { return document.querySelector(s); };
        var card = document.getElementById('qcCard');
        var textEl = document.getElementById('qcText');
        var nameIn = document.getElementById('qcName-in');
        var handleIn = document.getElementById('qcHandle-in');
        var checkIn = document.getElementById('qcCheck-in');

        function saveProfile() {
          try { localStorage.setItem('tools.qc.profile', JSON.stringify({ name: state.name, handle: state.handle, avatar: state.avatar })); } catch (e) {}
        }
        try {
          var p = JSON.parse(localStorage.getItem('tools.qc.profile') || 'null');
          if (p) {
            if (p.name) { state.name = p.name; nameIn.value = p.name; }
            if (p.handle) { state.handle = p.handle; handleIn.value = p.handle; }
            if (p.avatar) state.avatar = p.avatar;
          }
        } catch (e) {}

        function textSize(len) { return len <= 30 ? 40 : len <= 60 ? 34 : len <= 100 ? 28 : len <= 160 ? 24 : 20; }

        function render() {
          card.className = 'tcard ' + state.scheme + ' ' + state.ratio;
          if (document.activeElement !== textEl) {
            textEl.textContent = state.text || '';
            textEl.classList.toggle('is-empty', !/\S/.test(state.text || ''));
          }
          $('#qcName').textContent = state.name || '名字';
          $('#qcHandle').textContent = state.handle || '@handle';
          $('#qcCheck').style.display = state.check ? 'flex' : 'none';
          var ava = $('#qcAva');
          ava.innerHTML = state.avatar ? '<img src="' + state.avatar + '">' : '<span class="ph">人</span>';
          var prev = $('#qcAvaPrev');
          prev.innerHTML = state.avatar ? '<img src="' + state.avatar + '">' : '<span>人</span>';
          $('#qcAvaClr').style.display = state.avatar ? '' : 'none';
          textEl.style.fontSize = textSize((state.text || '').length) + 'px';
          fit();
        }

        /* 预览缩放：按中栏可用宽度把 540px 卡片等比缩小显示 */
        function fit() {
          var canvas = document.querySelector('#pane-quote .canvas');
          var fitEl = document.getElementById('qcFit');
          if (!canvas || !fitEl) return;
          var cw = canvas.clientWidth;
          if (cw < 60) return; /* 面板隐藏时跳过 */
          var avail = cw - 32 - 80 - 4; /* canvas 左右 padding 32 + 点阵 padding 80 */
          var s = Math.max(0.3, Math.min(1, avail / 540));
          fitEl.style.setProperty('--qc-s', s);
          fitEl.style.width = Math.round(540 * s) + 'px';
          fitEl.style.height = Math.round((state.ratio === 'r11' ? 540 : 720) * s) + 'px';
        }
        window.addEventListener('resize', fit);

        // 直接在卡片上编辑（所见即所得）：同步状态，但不整卡重渲染以保住光标
        textEl.addEventListener('input', function () {
          var raw = textEl.innerText.replace(/\n$/, '');
          state.text = /\S/.test(raw) ? raw : '';
          textEl.classList.toggle('is-empty', !/\S/.test(textEl.textContent));
          textEl.style.fontSize = textSize(state.text.length) + 'px';
        });
        nameIn.addEventListener('input', function () { state.name = nameIn.value; render(); saveProfile(); });
        handleIn.addEventListener('input', function () { state.handle = handleIn.value; render(); saveProfile(); });
        checkIn.addEventListener('change', function () { state.check = checkIn.checked; render(); });

        /* 随机金句：内置句库 + 构建时从已发布文章/书集抽取的句子（data-quotes），合并去重 */
        var QUOTES = (function () {
          var base = [
          '写作，是把混乱的想法一个字一个字排好队。',
          '你不需要灵感，你需要坐下来。',
          '每天写一点，比偶尔写一篇更有力量。',
          '写完，比写得好更重要。',
          '别人买的不是你的文字，是你看世界的方式。',
          '先把故事讲清楚，再谈技巧。',
          '真正的专业，是把简单的事重复做。',
          '你的经历，就是你最深的护城河。',
          '别等准备好，边做边准备。',
          '写作是思考的显影液。',
          '一句话能说清的事，不要用一段话。',
          '慢就是快，少就是多。',
          '作品会替你说话，在你不在场的时候。',
          '把注意力放在一件事上，你就已经赢了一半。',
          '公开写作，是给自己的思考装上一个截止日期。',
          '你写的每一篇，都在为下一篇铺路。',
          '好文章是改出来的，不是等出来的。',
          '真诚比技巧更难，也更值钱。',
          '别追热点，去追那些十年后还有人在意的问题。',
          '先写给自己，再写给世界。',
          '一个人能持续做下去的事，才叫事业。',
          '复杂是敌人，清楚是善意。',
          '你今天写下的字，是明天别人的路标。',
          '想法不值钱，做完才值钱。'
          ];
          var extra = [];
          try { extra = JSON.parse(document.getElementById('qcDice').getAttribute('data-quotes') || '[]') || []; } catch (e) {}
          return base.concat(extra.filter(function (q) { return base.indexOf(q) === -1; }));
        })();
        var lastQ = -1;
        document.getElementById('qcDice').addEventListener('click', function () {
          var i = lastQ;
          if (QUOTES.length > 1) { while (i === lastQ) { i = Math.floor(Math.random() * QUOTES.length); } }
          else { i = 0; }
          lastQ = i;
          if (document.activeElement === textEl) textEl.blur();
          state.text = QUOTES[i];
          render();
          toast('换了一句 · 可继续点，或直接在卡片上改');
