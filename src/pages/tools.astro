      border: 1px solid var(--color-border, #e7e5e4); background: var(--color-card-bg, #fff); color: var(--color-text-secondary, #57534e);
      display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 5;
      transition: color .2s, border-color .2s, background .2s; }
    .side-toggle:hover { color: var(--color-accent); border-color: rgba(245,80,0,.45); background: #fff7f2; }

    /* ============================================================
       公众号封面制作工具——全部样式收在 #pane-cover 作用域内，
       不泄漏到站点头部/其他页面（.logo 等类名与站点头部撞名）。
       ============================================================ */
    #pane-cover .cover-editor { display: flex; flex-direction: column; gap: 22px; align-items: stretch; }
    #pane-cover .pv-col { flex: none; min-width: 0; }
    #pane-cover .set-col { width: 100%; flex: none; display: flex; flex-direction: column; gap: 16px; }
    #pane-cover .set-group.composer { display: grid; grid-template-columns: auto minmax(320px, 1fr); gap: 18px 56px; align-items: start; }

    #pane-cover .cv-wrap { --s: .5; position: relative; overflow: hidden; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.18); background: transparent; }
    #pane-cover #wrap90 { width: calc(900px * var(--s)); max-width: 100%; height: calc(383px * var(--s)); }
    #pane-cover .cv-ex-row { display: flex; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
    #pane-cover .pv-tip { font-size: 12.5px; line-height: 1.7; color: #57534e; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 12px; padding: 12px 14px; margin-top: 20px; }
    #pane-cover .pv-tip b { color: #c2410c; }

    /* 封面画板（与站点品牌一致） */
    #pane-cover .cover90 { position: absolute; top: 0; left: 0; overflow: hidden; width: 900px; height: 383px;
      background: linear-gradient(140deg, #1c1917 0%, #292524 55%, #3a1a00 100%); color: #fff;
      font-family: var(--font-serif); transform: scale(var(--s, .5)); transform-origin: top left; }
    #pane-cover .cv-inner { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; }
    #pane-cover .cv-inner { justify-content: center; padding: 0 48px 0 84px; }
    #pane-cover .ctitle { font-weight: 700; line-height: 1.32; color: #fff; margin: 0; max-width: 760px; }
    #pane-cover .ctitle em { font-style: normal; color: #F55000; }
    #pane-cover .ctitle { cursor: text; outline: none; }
    #pane-cover .ctitle.is-empty::before { content: attr(data-ph); color: rgba(255,255,255,.42); font-weight: 400; }
    #pane-cover .ctitle.is-empty::after { content: '|'; margin-left: 2px; color: rgba(255,255,255,.7); font-weight: 400; animation: cv-blink 1.1s steps(1) infinite; }
    @keyframes cv-blink { 0%, 55% { opacity: .7; } 56%, 100% { opacity: 0; } }
    #pane-cover .brandrow { display: flex; align-items: center; gap: 12px; margin-top: 30px; }
    #pane-cover .clogo { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; flex: none; box-shadow: 0 0 0 2px rgba(245,80,0,.4); }
    #pane-cover .bn { font-weight: 700; font-size: 15px; color: #fff; }
    #pane-cover .bu { font-size: 12.5px; color: rgba(255,255,255,.66); margin-top: 1px; }
    #pane-cover .glow { position: absolute; right: -90px; bottom: -90px; width: 340px; height: 340px; z-index: 1;
      background: radial-gradient(circle, rgba(245,80,0,.20), transparent 70%); pointer-events: none; }
    #pane-cover .frame { position: absolute; inset: 0; border: 10px solid #F53F3F; pointer-events: none; z-index: 6; }

    /* ===== 设置卡（变体 1 · 整洁行式） ===== */
    #pane-cover .set-group { background: var(--color-card-bg); border: 1px solid var(--color-border, #ececea); border-radius: 14px; padding: 18px 18px 20px; }
    #pane-cover .composer { background: #fdfcfa; }
    #pane-cover .fld-label { display: block; font-size: 13px; color: var(--color-text-secondary); margin-bottom: 7px; }
    #pane-cover .fld-label b { color: var(--color-accent); }
    #pane-cover .ta-box { background: rgba(245,80,0,.035); border: 1px solid rgba(245,80,0,.14); border-radius: 12px; padding: 4px; transition: border-color .2s; }
    #pane-cover .ta-box:focus-within { border-color: rgba(245,80,0,.45); }
    #pane-cover .ta-box textarea { width: 100%; border: none; background: transparent; border-radius: 9px; padding: 10px 12px;
      font-family: var(--font-serif); font-size: 16px; color: var(--color-text); outline: none; resize: vertical; line-height: 1.6; box-sizing: border-box; }
    #pane-cover .inp { border: 1px solid var(--color-border, #e5e3df); border-radius: 10px; padding: 9px 12px;
      font-family: var(--font-serif); font-size: 14px; color: var(--color-text); background: #fff; outline: none; transition: border-color .2s; box-sizing: border-box; }
    #pane-cover .inp:focus { border-color: var(--color-accent); }
    #pane-cover .fr-dots { display: flex; gap: 9px; align-items: center; height: 38px; }
    #pane-cover .fr-dot { width: 26px; height: 26px; border-radius: 50%; border: 2px solid transparent; cursor: pointer; padding: 0; font-family: inherit; }
    #pane-cover .fr-dot.c-red { background: #F53F3F; }
    #pane-cover .fr-dot.c-ora { background: #F55000; }
    #pane-cover .fr-dot.c-none { background: #fff; border-color: var(--color-border, #e5e3df); color: var(--color-text-secondary); font-size: 12px; }
    #pane-cover .fr-dot.on { border-color: #1c1917; }

    /* 品牌行设置（头像/名称开关 + 上传 + 改名） */
    #pane-cover .brand-line { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; flex-wrap: wrap; }
    #pane-cover .tg { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; user-select: none; }
    #pane-cover .tg input { display: none; }
    #pane-cover .tg .sw { width: 38px; height: 21px; border-radius: 999px; background: #d6d3d1; position: relative; transition: background .18s; flex: none; }
    #pane-cover .tg .sw::after { content: ''; position: absolute; top: 2.5px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: left .18s; box-shadow: 0 1px 3px rgba(0,0,0,.2); }
    #pane-cover .tg input:checked + .sw { background: var(--color-accent); }
    #pane-cover .tg input:checked + .sw::after { left: 19px; }
    #pane-cover .tg .tl { font-size: 13px; color: var(--color-text-secondary); }
    #pane-cover .avatar-btn { display: inline-flex; align-items: center; gap: 7px; border: 1px dashed #d6d3d1; border-radius: 999px;
      background: #fff; padding: 4px 12px 4px 5px; font-family: inherit; font-size: 13px; color: var(--color-text-secondary); cursor: pointer; }
    #pane-cover .avatar-btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
    #pane-cover .avatar-btn img { width: 24px; height: 24px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px rgba(245,80,0,.4); }
    #pane-cover .name-inp { flex: 1; min-width: 0; }
    #pane-cover .cmp-hint { font-size: 12px; color: #a8a29e; margin-top: 6px; }

    /* 导出按钮（文艺简约：细边幽灵款，衬线字，去加粗） */
    #pane-cover .ex-btn { border: 1.5px solid #ddd9d3; border-radius: 12px; padding: 10px 26px;
      font-family: var(--font-serif); font-size: 15px; font-weight: 700; letter-spacing: .04em;
      color: #1c1917; background: #fff; cursor: pointer; transition: all .18s; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    #pane-cover .ex-btn.copy { color: #fff; border-color: #F55000; background: #F55000; }
    #pane-cover .ex-btn.copy:hover { background: #e04a00; border-color: #e04a00; color: #fff; }
    #pane-cover .ex-btn.dl:hover { border-color: #1c1917; color: #1c1917; }
    #pane-cover .ex-btn:disabled { opacity: .5; cursor: default; }
    #pane-cover #export-stage { position: absolute; left: -10000px; top: 0; width: 900px; height: 383px; }

    /* ============================================================
       金句卡片制作工具（推文截图风 · 双栏工作台）—— 全部收在
       #pane-quote 作用域内，不泄漏到站点头部 / 其他页面。
       ============================================================ */
    .btn { border: 1px solid var(--color-border, #e7e5e4); background: #fff; font-family: inherit; font-size: 14px; color: var(--color-text); padding: 11px 16px; border-radius: 11px; cursor: pointer; transition: all .2s; }
    .btn:hover { border-color: var(--color-accent); color: var(--color-accent); }
    .btn.primary { background: var(--color-accent); color: #fff; border-color: var(--color-accent); }
    .btn.primary:hover { filter: brightness(1.06); color: #fff; }

    #pane-quote .ws { display: flex; align-items: stretch; border: 1px solid var(--color-border, #e7e5e4); border-radius: 16px; overflow: hidden; background: #fff; }

    #pane-quote .canvas { flex: 1; min-width: 0; overflow: auto; display: flex; align-items: flex-start; justify-content: center; padding: 34px 16px; background: #faf9f7; }
    #pane-quote .canvas-dot { padding: 38px 40px; border-radius: 18px; }

    /* 预览缩放：外层量好尺寸，内层卡片原尺寸 transform 缩放（导出走离屏原尺寸克隆，不经缩放） */
    #pane-quote .card-fit { position: relative; overflow: hidden; border-radius: 10px; box-shadow: 0 20px 50px -18px rgba(28,25,23,.30); }
    #pane-quote .card-fit .tcard { transform: scale(var(--qc-s, 1)); transform-origin: top left; box-shadow: none; }
    #pane-quote #qc-stage { position: absolute; left: -10000px; top: 0; }
    #pane-quote #qc-stage .tcard { transform: none; }

    #pane-quote .props { width: 300px; flex: none; background: #fff; border-left: 1px solid var(--color-border, #e7e5e4); padding: 22px 18px; overflow-y: auto; }
    #pane-quote .field { margin-bottom: 16px; }
    #pane-quote .fld-label { display: block; font-size: 13px; color: var(--color-text-secondary); margin-bottom: 7px; }
    #pane-quote .f-input, #pane-quote .f-area { width: 100%; padding: 11px 13px; border: 1px solid var(--color-border, #e7e5e4); border-radius: 11px; font-family: var(--font-serif); font-size: 14px; color: var(--color-text); background: #fff; outline: none; transition: border-color .2s; box-sizing: border-box; }
    #pane-quote .f-input:focus, #pane-quote .f-area:focus { border-color: var(--color-accent); }
    #pane-quote .f-area { resize: vertical; line-height: 1.7; }
    #pane-quote .ava-row { display: flex; align-items: center; gap: 12px; }
    #pane-quote .ava-prev { width: 54px; height: 54px; border-radius: 50%; overflow: hidden; flex: none; border: 1px dashed #d6d3d1; background: var(--soft, #f5f4f2); display: flex; align-items: center; justify-content: center; color: var(--color-text-secondary); font-size: 18px; }
    #pane-quote .ava-prev img { width: 100%; height: 100%; object-fit: cover; display: block; }
    #pane-quote .ava-btns { display: flex; flex-direction: column; gap: 6px; }
    #pane-quote .btn.sm { font-size: 12px; padding: 6px 12px; border-radius: 9px; }
    #pane-quote .check-row { display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; user-select: none; }
    #pane-quote .check-row input { width: 16px; height: 16px; accent-color: var(--color-accent); }
    #pane-quote .export { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--color-border, #e7e5e4); }
    #pane-quote .export .btn { width: 100%; margin-bottom: 10px; }
    #pane-quote .btn.big { font-size: 15px; font-weight: 700; padding: 13px 0; box-shadow: 0 6px 16px -6px rgba(245,80,0,.45); }
    #pane-quote a.btn { display: block; text-align: center; text-decoration: none; line-height: 1.4; }
    #pane-quote .qc-art-note { font-size: 12.5px; font-weight: 700; color: var(--color-text, #1c1917); margin-top: 8px; line-height: 1.6; text-align: center; }
    #pane-quote .cmp-hint { font-size: 11.5px; color: #a8a29e; line-height: 1.6; margin-top: 4px; }

    #pane-quote .seg { display: flex; border: 1px solid var(--color-border, #e7e5e4); border-radius: 11px; overflow: hidden; }
    #pane-quote .seg-btn { flex: 1; font-family: inherit; font-size: 13px; padding: 9px 0; border: none; background: var(--soft, #f5f4f2); color: var(--color-text-secondary); cursor: pointer; transition: .15s; }
    #pane-quote .seg-btn + .seg-btn { border-left: 1px solid var(--color-border, #e7e5e4); }
    #pane-quote .seg-btn.on { background: var(--color-accent); color: #fff; font-weight: 700; }

    /* 卡片（推文截图风） */
    #pane-quote .tcard { width: 540px; border-radius: 0; padding: 40px 56px 64px; font-family: var(--font-serif); display: flex; flex-direction: column; justify-content: center; gap: 44px; box-sizing: border-box; }
    #pane-quote .r34 { aspect-ratio: 3/4; }
    #pane-quote .r11 { aspect-ratio: 1/1; padding: 56px 52px; gap: 36px; }
    #pane-quote .t-head { display: flex; align-items: center; gap: 18px; }
    #pane-quote .t-ava { width: 96px; height: 96px; border-radius: 50%; flex: none; overflow: hidden; background: #d6d3d1; display: flex; align-items: center; justify-content: center; }
    #pane-quote .t-ava img { width: 100%; height: 100%; object-fit: cover; display: block; }
    #pane-quote .t-ava .ph { font-size: 34px; opacity: .5; }
    #pane-quote .t-id { min-width: 0; }
    #pane-quote .t-namerow { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    #pane-quote .t-name { font-size: 34px; font-weight: 800; line-height: 1.2; }
    #pane-quote .t-check { width: 30px; height: 30px; flex: none; display: flex; }
    #pane-quote .t-check svg { width: 100%; height: 100%; fill: #1d9bf0; display: block; }
    #pane-quote .t-handle { font-size: 22px; line-height: 1.3; margin-top: 6px; }
    #pane-quote .t-text { line-height: 1.62; font-weight: 500; word-break: break-word; white-space: pre-wrap; outline: none; cursor: text; }
    #pane-quote .t-text:empty::before, #pane-quote .t-text.is-empty::before { content: attr(data-ph); opacity: .3; }
    #pane-quote .t-text:empty::after, #pane-quote .t-text.is-empty::after { content: '|'; margin-left: 4px; opacity: .5; font-weight: 400; animation: qc-blink 1.1s steps(1) infinite; }
    @keyframes qc-blink { 0%, 55% { opacity: .5; } 56%, 100% { opacity: 0; } }
    /* 导出时隐藏占位提示与光标，不进图片 */
    #pane-quote #qc-stage .t-text:empty::before, #pane-quote #qc-stage .t-text:empty::after,
    #pane-quote #qc-stage .t-text.is-empty::before, #pane-quote #qc-stage .t-text.is-empty::after { content: none; }
    #pane-quote .v-light { background: #fff; color: #0f1419; }
    #pane-quote .v-light .t-handle { color: #536471; }
    #pane-quote .v-dark { background: #000; color: #e7e9ea; }
    #pane-quote .v-dark .t-handle { color: #71767b; }
    #pane-quote .v-paper { background: #f7f3ec; color: #26221d; }
    #pane-quote .v-paper .t-handle { color: #8a8378; }
    /* 深色品牌：与划线生成金句卡 B 款同源（暖黑渐变 + 右上橙光晕） */
    #pane-quote .v-brand { background: linear-gradient(140deg, #1c1917 0%, #292524 55%, #3a1a00 100%); color: #fff; position: relative; overflow: hidden; }
    #pane-quote .v-brand .t-handle { color: rgba(255, 255, 255, 0.72); }
    #pane-quote .t-glow { display: none; }
    #pane-quote .v-brand .t-glow { display: block; position: absolute; top: -80px; right: -80px; width: 340px; height: 340px; background: radial-gradient(circle, rgba(245, 80, 0, 0.28), transparent 70%); pointer-events: none; }

    #pane-quote .toast { position: fixed; left: 50%; bottom: 34px; transform: translateX(-50%) translateY(20px); background: #1c1917; color: #fff; font-size: 13px; padding: 10px 22px; border-radius: 999px; opacity: 0; pointer-events: none; transition: .25s; z-index: 99; font-family: var(--font-serif); }
    #pane-quote .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* ============================================================
       书写伙伴（白噪音 + 专注时间 + 即时排版）—— 收在 #pane-write 作用域
       ============================================================ */
    #pane-write .wp-wrap { max-width: 760px; margin: 0 auto; }
    #pane-write .wp-head { margin-bottom: 16px; }
    #pane-write .wp-brand { display: inline-block; font-size: 21px; font-weight: 700; letter-spacing: 1px;
      background: linear-gradient(transparent 58%, rgba(245,80,0,.32) 58%); padding: 0 4px 1px; }
    #pane-write .wp-brand em { font-style: normal; color: var(--color-accent); }

    /* 英雄播放卡（方案 4） */
    #pane-write .wp-hero { background: linear-gradient(140deg,#33261a,#211913); border-radius: 16px; padding: 18px 20px 16px; margin-bottom: 18px;
      box-shadow: 0 12px 30px -16px rgba(28,25,23,.55); }
    #pane-write .wp-row1 { display: flex; align-items: center; gap: 13px; margin-bottom: 14px; }
    #pane-write .wp-play { width: 46px; height: 46px; border-radius: 50%; border: none; background: var(--color-accent); color: #fff; font-size: 15px; cursor: pointer; flex: none; font-family: inherit; }
    #pane-write .wp-play:hover { background: #e04a00; }
    #pane-write .wp-title { color: #f3e8d7; font-size: 15px; flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    #pane-write .wp-clock { width: 30px; height: 30px; flex: none; }
    #pane-write .wp-durbox { border: 1.5px solid rgba(243,232,215,.5); color: #f3e8d7; font-size: 13px; font-weight: 700; padding: 5px 12px; border-radius: 9px; white-space: nowrap; }
    #pane-write .wp-remain { color: #f3e8d7; font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; min-width: 52px; text-align: right; }
    #pane-write .wp-bar { height: 5px; border-radius: 3px; background: rgba(255,255,255,.16); overflow: hidden; }
    #pane-write .wp-bar i { display: block; height: 100%; width: 0; background: var(--color-accent); border-radius: 3px; transition: width .25s linear; }
    #pane-write .wp-row2 { display: flex; align-items: center; gap: 7px; margin-top: 14px; flex-wrap: wrap; }
    #pane-write #wpSoundSeg, #pane-write #wpDurSeg { display: flex; gap: 7px; }
    #pane-write .wp-chip { font-family: inherit; font-size: 12.5px; padding: 6px 13px; border-radius: 999px; border: none; background: rgba(255,255,255,.12); color: #f3e8d7; cursor: pointer; transition: .15s; white-space: nowrap; }
    #pane-write .wp-chip:hover { background: rgba(255,255,255,.22); }
    #pane-write .wp-chip.on { background: var(--color-accent); color: #fff; font-weight: 700; }
    #pane-write .wp-sep { width: 1px; height: 18px; background: rgba(255,255,255,.2); margin: 0 5px; }
    #pane-write .wp-reset { font-family: inherit; font-size: 12.5px; font-weight: 700; padding: 6px 13px; border-radius: 999px; border: 1px solid rgba(243,232,217,.45); background: transparent; color: #f3e8d7; cursor: pointer; margin-left: auto; }
    #pane-write .wp-reset:hover { background: rgba(255,255,255,.12); }
    #pane-write .wp-copymd { font-family: inherit; font-size: 13.5px; font-weight: 700; padding: 9px 18px; border-radius: 11px; cursor: pointer; transition: .15s; }
    #pane-write .wp-copymd.ghost { border: 1.5px solid var(--color-accent); color: var(--color-accent); background: #fff; }
    #pane-write .wp-copymd.ghost:hover { background: #fff3e8; }
    #pane-write .wp-copymd.solid { border: 1.5px solid var(--color-accent); background: var(--color-accent); color: #fff; box-shadow: 0 4px 12px -4px rgba(245,80,0,.5); }
    #pane-write .wp-copymd.solid:hover { background: #e04a00; border-color: #e04a00; }

    #pane-write .wp-paper { background: var(--color-card-bg); border: 1px solid var(--color-border); border-radius: 16px; padding: 30px 34px 40px; box-shadow: 0 10px 30px -16px rgba(28,25,23,.18); }
    #pane-write #wpEditor { font-size: 18px; line-height: 1.85; }
    #pane-write .blk { margin: 0 0 2px; }
    #pane-write .blk .rendered { cursor: text; padding: 1px 2px; border-radius: 6px; transition: background .15s; }
    #pane-write .blk .rendered:hover { background: rgba(245,80,0,.05); }
    #pane-write .blk .src { display: none; width: 100%; border: none; outline: none; background: transparent; resize: none; overflow: hidden;
      font-family: inherit; font-size: 18px; line-height: 1.85; color: var(--color-text); caret-color: var(--color-accent); padding: 1px 2px; }
    #pane-write .blk.editing .src { display: block; }
    #pane-write .blk.editing .rendered { display: none; }

    /* 渲染样式（与站点品牌一致） */
    #pane-write #wpEditor h1 { font-size: 26px; font-weight: 700; line-height: 1.4; text-align: center; margin: 18px 0 12px; }
    #pane-write #wpEditor h2 { font-size: 22px; font-weight: 700; line-height: 1.35; margin: 14px 0 8px; }
    #pane-write #wpEditor h3 { font-size: 19px; font-weight: 700; margin: 12px 0 6px; }
    #pane-write #wpEditor h4, #pane-write #wpEditor h5, #pane-write #wpEditor h6 { font-weight: 700; margin: 8px 0 4px; }
    #pane-write #wpEditor p { margin: 6px 0; }
    #pane-write #wpEditor strong { color: var(--color-accent); font-weight: 700; }
