      /* 专注模式：优先原生全屏；被 iframe/权限拦截时自动降级为伪全屏（fixed 铺满视口） */
      var wpFocus = document.getElementById('wpFocus');
      function wpWrapEl() { return document.querySelector('#pane-write .wp-wrap'); }
      function paintFocusBtn() {
        var on = document.fullscreenElement || (wpWrapEl() && wpWrapEl().classList.contains('wp-fs'));
        wpFocus.textContent = on ? '✕ 退出专注' : '⛶ 专注模式';
      }
      function pseudoFs(on) { var el = wpWrapEl(); if (el) el.classList.toggle('wp-fs', on); paintFocusBtn(); }
      function exitFocus() {
        if (document.fullscreenElement && document.exitFullscreen) { document.exitFullscreen(); }
        pseudoFs(false);
      }
      wpFocus.addEventListener('click', function () {
        var el = wpWrapEl();
        if (!el) return;
        if (document.fullscreenElement || el.classList.contains('wp-fs')) { exitFocus(); return; }
        if (document.fullscreenEnabled && el.requestFullscreen) {
          try {
            var p = el.requestFullscreen();
            if (p && p.catch) p.catch(function () { pseudoFs(true); });
          } catch (e) { pseudoFs(true); }
          setTimeout(function () { if (!document.fullscreenElement) pseudoFs(true); }, 350);
        } else {
          pseudoFs(true);
        }
      });
      document.addEventListener('fullscreenchange', paintFocusBtn);
      document.addEventListener('keydown', function (ev) {
        if (ev.key === 'Escape' && !document.fullscreenElement) {
          var el = wpWrapEl();
          if (el && el.classList.contains('wp-fs')) pseudoFs(false);
        }
      });
      document.addEventListener('keydown', function (ev) {
        var tg = ev.target;
        if (tg && (tg.tagName === 'TEXTAREA' || tg.tagName === 'INPUT')) return;
        if (ev.key === 't' || ev.key === 'T') {
          FAST = !FAST;
          if (sessionOn) { endAt = Date.now() + remainSec / (FAST ? 60 : 1) * 1000; }
          updateTitle();
        }
      });
      /* 初始化即加载默认曲目（耀斑）真实音频：修复点播放键走合成演示、标题误标「待上传真实音频」 */
      applySound(curSound);
      updateTitle(); paint();

      // Markdown 解析
      function esc(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
      /* 公众号专用：全部内联样式（公众号会剥掉 <style> 与外部 class，只认 style 属性） */
      var WX = {
        p: 'margin:0 0 20px;font-size:16px;line-height:1.8;color:#3f3f3f;letter-spacing:.03em;text-align:justify;word-break:break-word;',
        h: 'font-weight:700;color:#1a1a1a;line-height:1.45;margin:32px 0 16px;letter-spacing:.02em;',
        bq: 'border-left:3px solid #d6d3d1;background:transparent;padding:2px 0 2px 16px;margin:0 0 20px;color:#44403c;font-size:15px;line-height:1.8;border-radius:0;',
        ul: 'margin:0 0 20px;padding-left:24px;color:#3f3f3f;font-size:16px;line-height:1.85;',
        li: 'margin:0 0 8px;',
        pre: 'background:#1f1b18;color:#ece5de;padding:15px 16px;border-radius:8px;font-size:13px;line-height:1.75;white-space:pre-wrap;word-break:break-all;margin:0 0 20px;font-family:Menlo,Consolas,monospace;',
        code: 'background:#f4f0ec;padding:2px 6px;border-radius:4px;font-size:14px;color:#b1541f;',
        hr: 'height:1px;background:#ebe5df;margin:30px 0;font-size:0;line-height:0;',
        a: 'color:#F55000;text-decoration:none;border-bottom:1px solid rgba(245,80,0,.45);',
        strong: 'font-weight:700;color:#F55000;'
      };
      function inline(t, wx) {
        t = esc(t);
        if (wx) {
          t = t.replace(/`([^`]+)`/g, '<span style="' + WX.code + '">$1</span>');
          t = t.replace(/\*\*([^*]+)\*\*/g, '<strong style="' + WX.strong + '">$1</strong>');
          t = t.replace(/(^|[^*\w])\*([^*\n]+)\*/g, '$1<em style="font-style:italic;">$2</em>');
          t = t.replace(/~~([^~]+)~~/g, '<span style="text-decoration:line-through;color:#999;">$1</span>');
          t = t.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" style="' + WX.a + '">$1</a>');
          return t;
        }
        t = t.replace(/`([^`]+)`/g, '<code>$1</code>');
        t = t.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
        t = t.replace(/(^|[^*\w])\*([^*\n]+)\*/g, '$1<em>$2</em>');
        t = t.replace(/~~([^~]+)~~/g, '<del>$1</del>');
        t = t.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
        return t;
      }
      function parse(md, wx) {
        var lines = md.split('\n'), html = '', i = 0;
        while (i < lines.length) {
          var line = lines[i];
          if (/^```/.test(line)) {
            var buf = []; i++;
            while (i < lines.length && !/^```/.test(lines[i])) { buf.push(lines[i]); i++; }
            i++;
            html += wx
              ? '<section style="' + WX.pre + '">' + esc(buf.join('\n')).replace(/\n/g, '<br>') + '</section>'
              : '<pre><code>' + esc(buf.join('\n')) + '</code></pre>';
            continue;
          }
          if (/^\s*---+\s*$/.test(line)) { html += wx ? '<section style="' + WX.hr + '"></section>' : '<hr>'; i++; continue; }
          var h = line.match(/^(#{1,6})\s+(.*)$/);
          if (h) {
            var lv = h[1].length;
            var hs = [26, 22, 19, 17, 16, 16][lv - 1];
            html += wx
              ? '<section style="font-size:' + hs + 'px;' + WX.h + '">' + inline(h[2], true) + '</section>'
              : '<h' + lv + '>' + inline(h[2]) + '</h' + lv + '>';
            i++; continue;
          }
          if (/^\s*>\s?/.test(line)) {
            var q = [];
            while (i < lines.length && /^\s*>\s?/.test(lines[i])) { q.push(lines[i].replace(/^\s*>\s?/, '')); i++; }
            html += wx
              ? '<section style="' + WX.bq + '">' + inline(q.join('<br>'), true) + '</section>'
              : '<blockquote>' + inline(q.join('<br>')) + '</blockquote>';
            continue;
          }
          if (/^\s*[-*]\s+/.test(line)) {
            var ul = [];
            while (i < lines.length && /^\s*[-*]\s+/.test(lines[i])) { ul.push(inline(lines[i].replace(/^\s*[-*]\s+/, ''), wx)); i++; }
            html += wx
              ? '<ul style="' + WX.ul + '">' + ul.map(function (x) { return '<li style="' + WX.li + '">' + x + '</li>'; }).join('') + '</ul>'
              : '<ul>' + ul.map(function (x) { return '<li>' + x + '</li>'; }).join('') + '</ul>';
            continue;
          }
          if (/^\s*\d+\.\s+/.test(line)) {
            var ol = [];
            while (i < lines.length && /^\s*\d+\.\s+/.test(lines[i])) { ol.push(inline(lines[i].replace(/^\s*\d+\.\s+/, ''), wx)); i++; }
            html += wx
              ? '<ol style="' + WX.ul + '">' + ol.map(function (x) { return '<li style="' + WX.li + '">' + x + '</li>'; }).join('') + '</ol>'
              : '<ol>' + ol.map(function (x) { return '<li>' + x + '</li>'; }).join('') + '</ol>';
            continue;
          }
          if (line.trim() === '') { i++; continue; }
          var p = [];
          while (i < lines.length && lines[i].trim() !== '' && !/^(#{1,6})\s/.test(lines[i]) && !/^\s*>\s?/.test(lines[i]) && !/^\s*[-*]\s+/.test(lines[i]) && !/^\s*\d+\.\s+/.test(lines[i]) && !/^```/.test(lines[i]) && !/^\s*---+\s*$/.test(lines[i])) { p.push(inline(lines[i], wx)); i++; }
          if (p.length) html += wx ? '<section style="' + WX.p + '">' + p.join('<br>') + '</section>' : '<p>' + p.join('<br>') + '</p>';
        }
        return html || '<p class="ph">写点什么…（点此编辑）</p>';
      }

      // 块编辑器
      var wpEditor = document.getElementById('wpEditor'), wpWc = document.getElementById('wpWc');
      function fit(ta) { ta.style.height = 'auto'; ta.style.height = ta.scrollHeight + 'px'; }
      function countWords() { var n = 0; wpEditor.querySelectorAll('.blk').forEach(function (b) { n += (b.dataset.md || '').replace(/\s/g, '').length; }); wpWc.textContent = n + ' 字'; }
      function renderBlock(b) {
        var md = b.dataset.md || '';
        b.querySelector('.rendered').innerHTML = md.trim() === '' ? '<p class="ph">' + (b.dataset.ph || '写点什么…（点此编辑）') + '</p>' : parse(md);
        b.classList.remove('editing');
        countWords();
      }
      function enterEdit(b) {
        var ta = b.querySelector('.src'); ta.value = b.dataset.md || '';
        ta.placeholder = b.dataset.ph || '';
        b.classList.add('editing'); fit(ta); ta.focus();
        var v = ta.value; ta.setSelectionRange(v.length, v.length);
      }
      function commit(b) { b.dataset.md = b.querySelector('.src').value; renderBlock(b); }
      function newBlock(after) {
        var b = makeBlock('');
        after.parentNode.insertBefore(b, after.nextSibling);
        enterEdit(b);
      }
      function makeBlock(md) {
        var b = document.createElement('div'); b.className = 'blk'; b.dataset.md = md || '';
        b.innerHTML = '<div class="rendered"></div><textarea class="src" rows="1"></textarea>';
        b.querySelector('.rendered').addEventListener('click', function () { enterEdit(b); });
        var ta = b.querySelector('.src');
        ta.addEventListener('input', function () { b.dataset.md = ta.value; fit(ta); countWords(); });
        ta.addEventListener('blur', function () { commit(b); });
        /* Markdown 快捷键：把选区（或占位词）包进语法标记 */
        function wrapSel(before, after, fallback) {
          var s = ta.selectionStart, e = ta.selectionEnd, v = ta.value;
          var sel = v.slice(s, e);
          var has = sel.length > 0, inner = has ? sel : fallback;
          ta.value = v.slice(0, s) + before + inner + after + v.slice(e);
          b.dataset.md = ta.value; fit(ta); countWords();
          var a = s + before.length;
          ta.setSelectionRange(a, a + inner.length);
          ta.focus();
        }
        ta.addEventListener('keydown', function (ev) {
          var mod = ev.ctrlKey || ev.metaKey;
          if (mod && (ev.key === 'b' || ev.key === 'B')) { ev.preventDefault(); wrapSel('**', '**', '加粗文字'); return; }
          if (mod && (ev.key === 'i' || ev.key === 'I')) { ev.preventDefault(); wrapSel('*', '*', '斜体文字'); return; }
          if (mod && (ev.key === 'k' || ev.key === 'K')) { ev.preventDefault(); wrapSel('[', '](https://)', '链接文字'); return; }
          if (ev.key === 'Enter' && !ev.shiftKey) {
            ev.preventDefault();
            if (ta.value.trim() === '') return;
            commit(b); newBlock(b);
          } else if (ev.key === 'Backspace' && ta.selectionStart === 0 && ta.selectionEnd === 0) {
            var prev = b.previousElementSibling;
            if (prev && prev.classList.contains('blk')) { ev.preventDefault(); b.remove(); enterEdit(prev); }
          }
        });
        return b;
      }

      var seed = [
        '# 白噪音+专注时间+排版',
        '### 这是一个集三者一起的工具。',
        '你可以在这里写作、听白噪音、专注写作25分钟。',
        '* 它支持Markdown格式',
        '- 写完就排版完。Markdown教程以及，读一读：[《工具箱 2：AI时代，写作就是编程。》](https://mp.weixin.qq.com/s/82u-7l75Z04l7ohQzQTQLg)',
        '比如引用',
        '> 我是一个引用',
        '我是**加粗**过的',
        '还有列表、代码块等等。换行要 Shift+Enter；快捷键：Ctrl+B 加粗、Ctrl+I 斜体、Ctrl+K 链接，全选/复制和平时一样。',
        '你可以复制`Markdown`格式，也可以复制`HTML`直接插入到公众号文章中。',
        '对了，有任何bug，通过首页底部的联系方式告诉我。**让我们一起做好创作**。',
        ''
      ];
      seed.forEach(function (md) { wpEditor.appendChild(makeBlock(md)); });
      wpEditor.querySelectorAll('.blk').forEach(function (b) { renderBlock(b); });
      var wpLast = wpEditor.lastElementChild; if (wpLast && (wpLast.dataset.md || '').trim() === '') enterEdit(wpLast);

      wpEditor.addEventListener('keydown', function (ev) {
        if (ev.target && ev.target.classList && ev.target.classList.contains('src')) {
          if (ev.key.length === 1 || ev.key === 'Enter' || ev.key === 'Backspace') keyclick();
        }
      });

      // 复制 Markdown / 复制 HTML
      function copyText(text, btn, label, toastMsg) {
        function ok() { btn.textContent = '已复制 ✓'; gToast(toastMsg || '已复制到剪贴板'); setTimeout(function () { btn.textContent = label; }, 1600); }
        function legacy() {
          var ta = document.createElement('textarea'); ta.value = text;
          ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          try { document.execCommand('copy'); ok(); } catch (e) {}
          document.body.removeChild(ta);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(text).then(ok, legacy); }
        else legacy();
      }
      function collectMd() {
        var parts = [];
        wpEditor.querySelectorAll('.blk').forEach(function (b) {
          var v = (b.dataset.md || '').replace(/\s+$/, '');
          if (v.trim() !== '') parts.push(v);
        });
        return parts.join('\n\n');
      }
      function collectHtml() {
        var parts = [];
        wpEditor.querySelectorAll('.blk').forEach(function (b) {
          if ((b.dataset.md || '').trim() === '') return;
          parts.push(b.querySelector('.rendered').innerHTML);
        });
        return parts.join('\n');
      }
      var wpCopyMd = document.getElementById('wpCopyMd');
      wpCopyMd.addEventListener('click', function () { copyText(collectMd(), wpCopyMd, '复制 Markdown'); });
      /* 公众号专用 HTML：全部内联样式，粘进公众号后台不丢排版 */
      function collectWxHtml() {
        var parts = [];
        wpEditor.querySelectorAll('.blk').forEach(function (b) {
          var md = b.dataset.md || '';
          if (md.trim() === '') return;
          parts.push(parse(md, true));
        });
        return parts.join('\n');
      }
      var wpCopyHtml = document.getElementById('wpCopyHtml');
      /* 公众号粘贴专用：必须把 HTML 以 text/html 写入剪贴板——
         只写 text/plain 时，公众号编辑器会把 <section> 标签当纯文本原样显示（即"乱码"）。
         首选 ClipboardItem 双格式；降级用隐藏 contenteditable 选中 + execCommand('copy')（公众号排版工具的标准做法）。 */
      function copyRichHtml(html, btn, label) {
        function ok() { btn.textContent = '已复制 ✓'; gToast('已复制公众号排版，去公众号正文 Ctrl+V 粘贴'); setTimeout(function () { btn.textContent = label; }, 1600); }
        function legacy() {
          var box = document.createElement('div');
          box.contentEditable = 'true';
          box.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0;';
          box.innerHTML = html;
          document.body.appendChild(box);
          var range = document.createRange();
          range.selectNodeContents(box);
          var sel = window.getSelection();
          sel.removeAllRanges(); sel.addRange(range);
          var done = false;
          try { done = document.execCommand('copy'); } catch (e) {}
          sel.removeAllRanges();
          document.body.removeChild(box);
          if (done) ok(); else btn.textContent = '复制失败';
        }
        if (window.ClipboardItem && navigator.clipboard && navigator.clipboard.write) {
          try {
            var item = new ClipboardItem({
              'text/html': new Blob([html], { type: 'text/html' }),
              'text/plain': new Blob([html], { type: 'text/plain' })
            });
            navigator.clipboard.write([item]).then(ok, legacy);
            return;
          } catch (e) { /* 走降级 */ }
        }
        legacy();
      }
      wpCopyHtml.addEventListener('click', function () { copyRichHtml(collectWxHtml(), wpCopyHtml, '复制 HTML'); });
      /* 马上写一篇：一键清空全部示例占位语，只剩「我要记录···」，开始打字自动覆盖 */
      var wpStart = document.getElementById('wpStart');
      wpStart.addEventListener('click', function () {
        wpEditor.innerHTML = '';
        var b = makeBlock('');
        b.dataset.ph = '我要记录···';
        wpEditor.appendChild(b);
        enterEdit(b);
        countWords();
      });
    })();

  </script>

