---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="工具箱 · 像企业家一样写作">
  <div class="tools-layout">
    <aside class="side">
      <div class="side-title">工具箱</div>
      <ul id="side-menu">
        <li data-pane="pane-cover" class="active"><span class="num">1)</span><span>公众号封面制作</span></li>
        <li data-pane="pane-quote"><span class="num">2)</span><span>金句卡片制作</span></li>
      </ul>
    </aside>

    <main class="workspace">
      <!-- 1) 公众号封面制作 -->
      <section class="pane" id="pane-cover">
        <div class="cover-editor">
          <!-- 预览列 -->
          <div class="pv-col">
            <div class="cv-wrap" id="wrap90"><!-- cover90 --></div>
            <div class="pv-actions">
              <button class="ex-btn copy" data-t="90">复制图片</button>
              <button class="ex-btn dl" data-t="90">下载图片</button>
              <span class="pv-tag">头条 900 × 383 · 导出 2 倍像素</span>
            </div>

            <div class="cv-wrap" id="wrap20"><!-- cover20 --></div>
            <div class="pv-actions">
              <button class="ex-btn copy" data-t="20">复制图片</button>
              <button class="ex-btn dl" data-t="20">下载图片</button>
              <span class="pv-tag">次条 200 × 200 · 预览按比例缩小</span>
            </div>

            <p class="pv-tip"><b>拿到图片：</b>点「下载图片」直接下高清图，公众号后台上传即可；或点「复制图片」后 Ctrl+V 粘贴。<br>头条文案支持 <b>**强调**</b> 橙红高亮（如 <b>**价值**</b>，是有效需求的满足。）；次条徽标会自动带出强调词，可改。</p>
          </div>

          <!-- 设置列 -->
          <div class="set-col">
            <div class="set-group composer">
              <span class="fld-label">头条文案（支持 <b>**强调**</b>）</span>
              <div class="ta-box">
                <textarea id="f-headline" rows="3">**价值**，是有效需求的满足。</textarea>
              </div>

              <div class="cmp-div"></div>

              <div class="cmp-row">
                <div class="fld">
                  <span class="fld-label">次条徽标（≤4 字）</span>
                  <input id="f-badge" class="inp" type="text" maxlength="4" placeholder="自动带出强调词"/>
                </div>
                <div class="fld">
                  <span class="fld-label">边框颜色</span>
                  <div class="fr-dots" id="seg-frame">
                    <button class="fr-dot c-red on" data-v="#F53F3F" title="红" aria-label="红"></button>
                    <button class="fr-dot c-ora" data-v="#F55000" title="橙" aria-label="橙"></button>
                    <button class="fr-dot c-none" data-v="" title="无">无</button>
                  </div>
                </div>
              </div>

              <div class="cmp-div"></div>

              <div class="brand-block">
                <span class="fld-label">品牌行</span>
                <div class="brand-line">
                  <label class="tg"><input type="checkbox" id="tg-avatar" checked/><span class="sw"></span><span class="tl">头像</span></label>
                  <button id="btn-avatar" class="avatar-btn" title="上传头像图片">
                    <img id="avatar-thumb" src="/images/logo-180x180.png" alt="头像"/>
                    <span>上传头像</span>
                  </button>
                  <input type="file" id="f-avatar" accept="image/*" hidden/>
                </div>
                <div class="brand-line">
                  <label class="tg"><input type="checkbox" id="tg-name" checked/><span class="sw"></span><span class="tl">名称</span></label>
                  <input id="f-name" class="inp name-inp" type="text" maxlength="14" value="像企业家一样写作"/>
                </div>
                <div class="cmp-hint">头像 / 名称全关时，品牌行整体收起；上传的头像本机记住，下次不用重传。</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 离屏导出舞台（原生尺寸，避免缩放干扰 html2canvas；放在 pane 内以复用作用域样式） -->
        <div id="export-stage"></div>
      </section>

      <!-- 2) 金句卡片制作（独立工具） -->
      <section class="pane" id="pane-quote" hidden>
        <div class="tool-editor">
          <div class="te-preview">
            <div class="qcard q-a" id="qCard">
              <div class="q-mark">“</div>
              <div class="q-text"></div>
              <div class="q-foot">
                <div class="q-src"></div>
                <div class="q-brand">像企业家一样写作</div>
              </div>
            </div>
          </div>

          <div class="te-form">
            <div class="f-sec">
              <label class="f-label">引言</label>
              <textarea class="f-area" id="qText" rows="5">价值，就是需求的有效满足。把一件事做到极致，需求自会找上门来。</textarea>
            </div>
            <div class="f-sec">
              <label class="f-label">出处（选填）</label>
              <input class="f-input" id="qSrc" value="《如何获得创业灵感》" placeholder="如：出自《如何选择》" />
            </div>
            <div class="f-sec">
              <label class="f-label">卡片样式</label>
              <div class="thumbs" id="qThumbs"></div>
            </div>
            <div class="f-sec">
              <label class="f-label">导出</label>
              <div class="export-btns">
                <button class="btn primary" id="qCopy">复制图片</button>
                <button class="btn" id="qDown">下载图片</button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    (function () {
      // ===== 侧边栏切换 =====
      var menu = document.getElementById('side-menu');
      menu.querySelectorAll('li').forEach(function (li) {
        li.addEventListener('click', function () {
          menu.querySelectorAll('li').forEach(function (x) { x.classList.remove('active'); });
          li.classList.add('active');
          document.querySelectorAll('.pane').forEach(function (p) { p.hidden = p.id !== li.dataset.pane; });
        });
      });

      // ===== 金句卡片工具 =====
      var SCHEMES = [
        { v: 'q-a', name: '品牌深色' },
        { v: 'q-b', name: '暖白极简' },
        { v: 'q-c', name: '杂志书页' },
        { v: 'q-d', name: '横版引言' }
      ];
      var QC_BG = { 'q-a': '#1c1917', 'q-b': '#ffffff', 'q-c': '#f3ede1', 'q-d': '#fafaf9' };
      var state = { text: '', src: '', scheme: 'q-a' };

      var qText = document.getElementById('qText');
      var qSrc = document.getElementById('qSrc');
      var qThumbs = document.getElementById('qThumbs');

      function qSize(t) {
        var n = (t || '').length;
        if (n <= 24) return 30; if (n <= 48) return 26; if (n <= 80) return 22; return 20;
      }

      function renderCards() {
        var cards = document.querySelectorAll('.qcard');
        cards.forEach(function (c) {
          c.className = 'qcard ' + state.scheme;
          c.querySelector('.q-text').textContent = state.text;
          c.querySelector('.q-text').style.fontSize = (state.scheme === 'q-d' ? 30 : qSize(state.text)) + 'px';
          var src = c.querySelector('.q-src');
          src.textContent = state.src;
          src.style.display = state.src ? 'block' : 'none';
        });
      }

      function buildThumbs() {
        qThumbs.innerHTML = SCHEMES.map(function (s) {
          return '<button class="thumb' + (s.v === state.scheme ? ' on' : '') + '" data-v="' + s.v + '">' +
            '<span class="t-card t-' + s.v[2] + '">' +
              '<span class="t-text">价值，就是需求的有效满足。</span>' +
              '<span class="t-foot"><span>《如何获得创业灵感》</span><b>像企业家一样写作</b></span>' +
            '</span>' +
            '<span class="t-label">' + s.name + '</span>' +
          '</button>';
        }).join('');
        qThumbs.querySelectorAll('.thumb').forEach(function (b) {
          b.addEventListener('click', function () {
            state.scheme = b.dataset.v;
            buildThumbs();
            renderCards();
          });
        });
      }

      qText.addEventListener('input', function () { state.text = qText.value; renderCards(); });
      qSrc.addEventListener('input', function () { state.src = qSrc.value; renderCards(); });

      function exportCanvas(id) {
        var el = document.getElementById(id);
        if (!window.html2canvas) { alert('图片组件未加载，请稍候重试'); return Promise.reject(); }
        return document.fonts.ready.then(function () {
          return html2canvas(el, { backgroundColor: QC_BG[state.scheme] || '#ffffff', scale: 2, useCORS: true, logging: false });
        });
      }
      function toast(m) {
        var t = document.getElementById('toast');
        if (!t) return;
        t.textContent = m; t.classList.add('show');
        clearTimeout(t._t); t._t = setTimeout(function () { t.classList.remove('show'); }, 1800);
      }
      document.getElementById('qCopy').addEventListener('click', function () {
        exportCanvas('qCard').then(function (cv) {
          cv.toBlob(function (blob) {
            if (blob && navigator.clipboard && window.ClipboardItem) {
              navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })])
                .then(function () { toast('已复制图片到剪贴板'); })
                .catch(function () { toast('复制失败，请用下载'); });
            } else { toast('当前环境不支持复制图片，请用下载'); }
          });
        }).catch(function () {});
      });
      document.getElementById('qDown').addEventListener('click', function () {
        exportCanvas('qCard').then(function (cv) {
          var a = document.createElement('a');
          a.download = '金句卡片.png';
          a.href = cv.toDataURL('image/png');
          a.click();
        }).catch(function () {});
      });

      state.text = qText.value;
      state.src = qSrc.value;
      buildThumbs();
      renderCards();
    })();

    // ===== 公众号封面制作工具 =====
    (function () {
      var SITE_URL = 'gusangciren.github.io';
      var DEFAULT_AVATAR = '/images/logo-180x180.png';
      var DEFAULT_NAME = '像企业家一样写作';

      var headlineEl = document.getElementById('f-headline');
      var badgeEl = document.getElementById('f-badge');
      var nameEl = document.getElementById('f-name');
      var tgAvatar = document.getElementById('tg-avatar');
      var tgName = document.getElementById('tg-name');
      var avatarThumb = document.getElementById('avatar-thumb');
      var btnAvatar = document.getElementById('btn-avatar');
      var fileAvatar = document.getElementById('f-avatar');
      var wrap90 = document.getElementById('wrap90'), wrap20 = document.getElementById('wrap20');
      var frameVal = '#F53F3F';
      var avatar = DEFAULT_AVATAR;
      var lastAuto = '';

      try {
        var savedA = localStorage.getItem('tools.cv.avatar');
        if (savedA) { avatar = savedA; avatarThumb.src = savedA; }
        var savedN = localStorage.getItem('tools.cv.name');
        if (savedN) { nameEl.value = savedN; }
      } catch (e) {}

      function esc(s) {
        return String(s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function cleanHL(raw) { return (raw || '').replace(/\*\*/g, ''); }
      function extractHL(raw) { var m = (raw || '').match(/\*\*([^*]+)\*\*/); return m ? m[1] : ''; }
      function titleSize(t) { var n = t.length; if (n <= 10) return 60; if (n <= 18) return 52; if (n <= 28) return 46; return 40; }
      function badgeSize(t) { var n = t.length; if (n <= 2) return 60; if (n === 3) return 48; return Math.max(26, Math.min(40, 168 / n)); }
      function renderTitle(raw) {
        if (!raw) return '';
        if (raw.indexOf('**') !== -1) {
          return raw.split(/(\*\*[^*]+\*\*)/g).map(function (p) {
            return /^\*\*[^*]+\*\*$/.test(p) ? '<em>' + esc(p.slice(2, -2)) + '</em>' : esc(p);
          }).join('');
        }
        return esc(raw);
      }
      function data() {
        return {
          headline: headlineEl.value,
          badge: badgeEl.value,
          frameColor: frameVal,
          avatar: avatar,
          name: nameEl.value || DEFAULT_NAME,
          showAvatar: tgAvatar.checked,
          showName: tgName.checked
        };
      }
      function build90(d) {
        var raw = d.headline || '';
        var el = document.createElement('div'); el.className = 'cover90';
        var frame = d.frameColor ? '<div class="frame" style="border-color:' + esc(d.frameColor) + '"></div>' : '';
        var brand = '';
        if (d.showAvatar || d.showName) {
          brand = '<div class="brandrow">';
          if (d.showAvatar) brand += '<img class="clogo" src="' + esc(d.avatar) + '" alt="logo"/>';
          if (d.showName) brand += '<div class="bt"><div class="bn">' + esc(d.name) + '</div><div class="bu">' + SITE_URL + '</div></div>';
          brand += '</div>';
        }
        el.innerHTML = '<div class="glow"></div>' + frame +
          '<div class="cv-inner"><h1 class="ctitle" style="font-size:' + titleSize(cleanHL(raw).length) + 'px">' + renderTitle(raw) + '</h1>' + brand + '</div>';
        return el;
      }
      function build20(d) {
        var el = document.createElement('div'); el.className = 'cover20';
        var frame = d.frameColor ? '<div class="frame" style="border-color:' + esc(d.frameColor) + '"></div>' : '';
        var inner = d.badge
          ? '<div class="cbadge" style="font-size:' + badgeSize(d.badge.length) + 'px">' + esc(d.badge) + '</div>'
          : '<div class="bc-site">' + esc(d.name) + '</div>';
        el.innerHTML = '<div class="glow"></div>' + frame + '<div class="ccenter">' + inner + '</div>';
        return el;
      }
      function render() {
        wrap90.innerHTML = ''; wrap90.appendChild(build90(data()));
        wrap20.innerHTML = ''; wrap20.appendChild(build20(data()));
      }
      function fit() {
        var w = wrap90.parentElement.clientWidth || 900;
        var s = Math.max(0.32, Math.min(0.62, (w - 8) / 900));
        wrap90.style.setProperty('--s', s);
        wrap20.style.setProperty('--s', s);
      }
      function exportEl(builder) {
        var stage = document.getElementById('export-stage');
        var el = builder(data());
        el.style.transform = 'none';
        el.style.position = 'static';
        stage.appendChild(el);
        return { el: el, done: function () { stage.removeChild(el); } };
      }
      async function renderArt(el) {
        await document.fonts.ready;
        return html2canvas(el, { backgroundColor: '#1c1917', scale: 2, useCORS: true, logging: false });
      }
      async function copyArt(btn, builder) {
        var t = btn.textContent; btn.disabled = true; btn.textContent = '生成中…';
        try {
          var x = exportEl(builder); var c = await renderArt(x.el); x.done();
          var blob = await new Promise(function (r) { c.toBlob(r, 'image/png'); });
          await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })]);
          btn.textContent = '已复制 ✓';
        } catch (e) { console.error(e); btn.textContent = '复制失败'; }
        setTimeout(function () { btn.textContent = t; btn.disabled = false; }, 1800);
      }
      async function downloadArt(btn, builder, name) {
        var t = btn.textContent; btn.disabled = true; btn.textContent = '生成中…';
        try {
          var x = exportEl(builder); var c = await renderArt(x.el); x.done();
          var a = document.createElement('a'); a.href = c.toDataURL('image/png'); a.download = name + '.png';
          document.body.appendChild(a); a.click(); a.remove();
          btn.textContent = '已下载 ✓';
        } catch (e) { console.error(e); btn.textContent = '下载失败'; }
        setTimeout(function () { btn.textContent = t; btn.disabled = false; }, 1800);
      }

      function onHL() {
        var h = extractHL(headlineEl.value);
        if (h && (badgeEl.value === '' || badgeEl.value === lastAuto)) { badgeEl.value = h; lastAuto = h; }
        else if (!h) { lastAuto = ''; }
        render();
      }
      headlineEl.addEventListener('input', onHL);
      badgeEl.addEventListener('input', function () {
        lastAuto = (badgeEl.value === extractHL(headlineEl.value)) ? badgeEl.value : '';
        render();
      });
      document.querySelectorAll('#seg-frame .fr-dot').forEach(function (b) {
        b.addEventListener('click', function () {
          document.querySelectorAll('#seg-frame .fr-dot').forEach(function (x) { x.classList.remove('on'); });
          b.classList.add('on');
          frameVal = b.dataset.v || '';
          render();
        });
      });
      tgAvatar.addEventListener('change', render);
      tgName.addEventListener('change', render);
      nameEl.addEventListener('input', function () {
        try { localStorage.setItem('tools.cv.name', nameEl.value); } catch (e) {}
        render();
      });
      btnAvatar.addEventListener('click', function () { fileAvatar.click(); });
      fileAvatar.addEventListener('change', function () {
        var f = fileAvatar.files && fileAvatar.files[0];
        if (!f) return;
        var rd = new FileReader();
        rd.onload = function () {
          var img = new Image();
          img.onload = function () {
            var max = 256, w = img.width, h = img.height;
            var k = Math.min(1, max / Math.max(w, h));
            var cv = document.createElement('canvas');
            cv.width = Math.round(w * k); cv.height = Math.round(h * k);
            cv.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height);
            avatar = cv.toDataURL('image/png');
            avatarThumb.src = avatar;
            try { localStorage.setItem('tools.cv.avatar', avatar); } catch (e) {}
            render();
          };
          img.src = rd.result;
        };
        rd.readAsDataURL(f);
        fileAvatar.value = '';
      });
      document.querySelectorAll('.ex-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var t = btn.dataset.t;
          var builder = t === '90' ? build90 : build20;
          if (btn.classList.contains('copy')) copyArt(btn, builder);
          else downloadArt(btn, builder, t === '90' ? '封面-头条' : '封面-次条');
        });
      });
      window.addEventListener('resize', fit);
      fit();
      onHL(); // 初始化：徽标自动带出 + 首次渲染
    })();
  </script>

  <style is:global>
    .tools-layout { max-width: 1100px; margin: 0 auto; display: flex; align-items: flex-start; padding: 0 20px; }
    .side { width: 208px; flex: none; padding: 34px 0; position: sticky; top: 56px; align-self: flex-start; }
    .side-title { font-size: 13px; color: var(--color-text-secondary); letter-spacing: 2px; padding: 0 14px 12px; }
    .side ul { list-style: none; margin: 0; padding: 0; }
    .side li { display: flex; align-items: center; gap: 10px; padding: 13px 14px; border-radius: 12px; cursor: pointer; color: var(--color-text-secondary); font-size: 15px; transition: background .2s, color .2s; margin-bottom: 4px; }
    .side li .num { font-variant-numeric: tabular-nums; color: var(--color-accent); font-weight: 700; width: 18px; flex: none; }
    .side li:hover { background: var(--soft, #f5f4f2); }
    .side li.active { background: var(--color-card-bg, #fff); color: var(--color-text, #1c1917); box-shadow: 0 1px 3px rgba(0,0,0,.06); font-weight: 700; }
    .workspace { flex: 1; min-width: 0; padding: 34px 0 60px; }

    /* ============================================================
       公众号封面制作工具——全部样式收在 #pane-cover 作用域内，
       不泄漏到站点头部/其他页面（.logo 等类名与站点头部撞名）。
       ============================================================ */
    #pane-cover .cover-editor { display: flex; gap: 28px; align-items: flex-start; }
    #pane-cover .pv-col { flex: 1; min-width: 0; position: sticky; top: 80px; }
    #pane-cover .set-col { width: 360px; flex: none; display: flex; flex-direction: column; gap: 16px; }

    #pane-cover .cv-wrap { --s: .5; position: relative; overflow: hidden; border-radius: 10px; box-shadow: 0 8px 24px rgba(0,0,0,.18); background: transparent; }
    #pane-cover #wrap90 { width: calc(900px * var(--s)); max-width: 100%; height: calc(383px * var(--s)); }
    #pane-cover #wrap20 { width: calc(200px * var(--s)); max-width: 100%; height: calc(200px * var(--s)); margin-top: 22px; }
    #pane-cover .pv-actions { display: flex; align-items: center; gap: 10px; margin-top: 10px; flex-wrap: wrap; }
    #pane-cover .pv-tag { font-size: 12px; color: #a8a29e; margin-left: auto; }
    #pane-cover .pv-tip { font-size: 12.5px; line-height: 1.7; color: #57534e; background: #fff7ed; border: 1px solid #fed7aa; border-radius: 12px; padding: 12px 14px; margin-top: 20px; }
    #pane-cover .pv-tip b { color: #c2410c; }

    /* 封面画板（与站点品牌一致） */
    #pane-cover .cover90, #pane-cover .cover20 { position: absolute; top: 0; left: 0; overflow: hidden;
      background: linear-gradient(140deg, #1c1917 0%, #292524 55%, #3a1a00 100%); color: #fff;
      font-family: var(--font-serif); transform: scale(var(--s, .5)); transform-origin: top left; }
    #pane-cover .cover90 { width: 900px; height: 383px; }
    #pane-cover .cover20 { width: 200px; height: 200px; }
    #pane-cover .cv-inner, #pane-cover .ccenter { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; }
    #pane-cover .cv-inner { justify-content: center; padding: 0 48px 0 84px; }
    #pane-cover .ctitle { font-weight: 700; line-height: 1.32; color: #fff; margin: 0; max-width: 760px; }
    #pane-cover .ctitle em { font-style: normal; color: #F55000; }
    #pane-cover .brandrow { display: flex; align-items: center; gap: 12px; margin-top: 30px; }
    #pane-cover .clogo { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; flex: none; box-shadow: 0 0 0 2px rgba(245,80,0,.4); }
    #pane-cover .bn { font-weight: 700; font-size: 15px; color: #fff; }
    #pane-cover .bu { font-size: 12.5px; color: rgba(255,255,255,.66); margin-top: 1px; }
    #pane-cover .ccenter { align-items: center; justify-content: center; gap: 10px; }
    #pane-cover .cbadge { font-weight: 700; color: #fff; letter-spacing: .04em; white-space: nowrap; }
    #pane-cover .cbadge em { font-style: normal; color: #F55000; }
    #pane-cover .bc-site { font-weight: 700; font-size: 20px; color: #fff; text-align: center; line-height: 1.4; padding: 0 10px; }
    #pane-cover .glow { position: absolute; right: -90px; bottom: -90px; width: 340px; height: 340px; z-index: 1;
      background: radial-gradient(circle, rgba(245,80,0,.20), transparent 70%); pointer-events: none; }
    #pane-cover .frame { position: absolute; inset: 0; border: 10px solid #F53F3F; pointer-events: none; z-index: 6; }
