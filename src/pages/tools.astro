---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

/* 随机金句库：构建时从已发布的 blog 文章与 books 书集里自动抽句，发文越多库越大 */
let diceQuotes = [];
try {
  const posts = await getCollection('blog');
  const chapters = await getCollection('books');
  const pool = new Set();
  const pick = (body) => {
    if (!body) return;
    const text = String(body)
      .replace(/^---[\s\S]*?---/, '')
      .replace(/```[\s\S]*?```/g, ' ')
      .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
      .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
      .replace(/[`>*#_~|]/g, '');
    text.split(/[。！？\n]/).forEach((raw) => {
      const s = raw.trim().replace(/^["'「『《（(【\s]+/, '').replace(/["'」』》》）)】\s]+$/, '');
      if (s.length >= 8 && s.length <= 42 && /[\u4e00-\u9fa5]/.test(s) && !/https?:|@|\/\/|^\d+$/.test(s)) pool.add(s);
    });
  };
  posts.forEach((p) => pick(p.body));
  chapters.forEach((c) => pick(c.body));
  diceQuotes = [...pool];
  /* 控制体积：全站可抽出上万句，随机取 260 句嵌入页面（每次构建换一批，像换新句库） */
  for (let i = diceQuotes.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [diceQuotes[i], diceQuotes[j]] = [diceQuotes[j], diceQuotes[i]];
  }
  diceQuotes = diceQuotes.slice(0, 260);
} catch (e) { diceQuotes = []; }
