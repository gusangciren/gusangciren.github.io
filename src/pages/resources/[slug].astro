---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { bookRecs, siteRecs, openSources } from '../../data/resources';

export function getStaticPaths() {
  // 注意：getStaticPaths 被提升执行，无法访问 frontmatter 顶层的 const，
  // 所以 TABS 必须在这里定义，并通过 props 传给模板。
  // 顺序与首页资源中心四卡对应（我的开源 → 我的书单 → 常读博客）；
  // 素材下载已按用户要求彻底下线（2026-10-19），不再恢复。
  const TABS = [
    { slug: 'opensource', label: '我的开源', sub: '我把方法整理成教程，也把工具做成作品，都在这' },
    { slug: 'recommended', label: '我的书单', sub: '我读过的书，和我为什么推荐它们' },
    { slug: 'blogs', label: '常读博客', sub: '我每周都会打开的网站与博客，不是导航站，是一份清单' },
  ];
  return TABS.map((t) => ({ params: { slug: t.slug }, props: { tab: t, tabs: TABS } }));
}

const { tab, tabs } = Astro.props;
// 面包屑右侧的「下一个」：按上面 TABS 顺序循环（开源 → 书单 → 博客 → 回到开源）
const tabIdx = tabs.findIndex((t) => t.slug === tab.slug);
const nextTab = tabs[(tabIdx + 1) % tabs.length];
// 书单（bookRecs）用 reasonBlocks 渲染独立推荐理由块；老数据只有 reason 时回退成单段
const blocksOf = (b) => (b.reasonBlocks ? b.reasonBlocks.split(/\n\s*\n/) : b.reason ? [b.reason] : []);
// 网站推荐只显示主机名（去 www.），长路径不占版面
const hostOf = (u) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
};

// 常读博客按 category 分组；组间顺序 = 各分类在 siteRecs 中首次出现的顺序，组内保持原顺序
const blogGroups = (() => {
  const order = [];
  const map = {};
  for (const s of siteRecs) {
    const c = s.category || '其他';
    if (!map[c]) { map[c] = []; order.push(c); }
    map[c].push(s);
  }
  return order.map((c) => [c, map[c]]);
})();

// 各分类页未完工时的占位文案（给提前点进来的读者一点惊喜）
const WIPS: Record<string, { t: string; p: string }> = {
  recommended: { t: '正在装修', p: '书正一本本从我的书架上往下搬，好用的工具也在挑挑拣拣。搬完、挑好，第一个告诉你。这会儿，不妨先去读读已经上架的《闭环》。' },
  opensource: { t: '写作台上', p: '教程正在排队，作品也在慢慢长大。写完一篇、做好一样，就上架一件，绝不注水。' },
};
const wip = WIPS[tab.slug];
// 只有该页还没有任何内容时才显示占位块，避免占位与真实内容同时出现
const isEmpty =
  tab.slug === 'opensource' ? openSources.length === 0
  : tab.slug === 'recommended' ? bookRecs.length + siteRecs.length === 0
  : false;
---

<BaseLayout title={`${tab.label} — 像企业家一样写作`}>
  <div class:list={["resources-page", tab.slug !== "opensource" && "rp-narrow"]}>
    {/* 面包屑（当前位置）+ 下一个分类：不用滚到底也能继续翻 */}
    <nav class="rp-crumb" aria-label="资源分类">
      <div class="rp-crumb-l">
        <a href="/#resources">资源中心</a><span class="rp-crumb-sep">›</span><b aria-current="page">{tab.label}</b>
      </div>
      <a class="rp-crumb-next" href={`/resources/${nextTab.slug}/`}>下一个：{nextTab.label} →</a>
    </nav>
    <p class="rp-sub">{tab.sub}</p>

    {tab.slug === 'recommended' && (
      <div class="rp-sec-body">
        {bookRecs.length > 0 && (
          <div class="rp-booklist">
            <div class="rp-bl-hd">
              <div class="rp-bl-title">我的<span class="hl">书单</span></div>
              <div class="rp-bl-meta">{bookRecs.length} 本 · 推荐值来自微信读书</div>
            </div>
            <p class="rp-bl-sub">不是「必读清单」，是我真的读过、并且改变过我做法的书。</p>
            <div class="rp-bl-list">
              {bookRecs.map((b, i) => {
                const paras = blocksOf(b);
                return (
                  <div class="rp-bl">
                    <span class="rp-bl-no">{String(i + 1).padStart(2, '0')}</span>
                    <div class="rp-bl-top">
                      <div class="rp-bl-cov">
                        {b.cover ? (
                          <img src={b.cover} alt={`${b.title} 封面`} loading="lazy" />
                        ) : (
                          <span class="rp-bl-cov-ph">待补封面</span>
                        )}
                      </div>
                      <div class="rp-bl-body">
                        <div class="rp-bl-l1">
                          <span class="rp-bl-t">{b.title}</span>
                          {b.author && <span class="rp-bl-a">{b.author}</span>}
                        </div>
                        {b.doubanIntro && <p class="rp-bl-d">{b.doubanIntro}</p>}
                        <div class="rp-bl-foot">
                          {(b.wrScore || b.doubanScore) && (
                            <span class="rp-bl-rate">
                              <b>{b.wrScore ? `${b.wrScore}%` : b.doubanScore}</b>
                              <i>{b.wrScore ? '推荐值' : '豆瓣'}</i>
                            </span>
                          )}
                          {b.wrBadge && <span class="rp-bl-badge">{b.wrBadge}</span>}
                          {b.publisher && <span class="rp-bl-dot">|</span>}
                          {b.publisher && <span class="rp-bl-pub">{b.publisher}</span>}
                          {b.readAt && <span class="rp-bl-date">{b.readAt}</span>}
                        </div>
                      </div>
                    </div>
                    {paras.length > 0 && (
                      <div class="rp-bl-quote">
                        <span class="rp-bl-qmark">❝</span>
                        {paras.map((p, k) => <p>{p}</p>)}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </div>
    )}

    {tab.slug === 'blogs' && (
      <div class="rp-sec-body rp-booklist">
        {siteRecs.length > 0 && (
          <>
            <div class="rp-bl-hd">
              <div class="rp-bl-title">常读<span class="hl">博客</span></div>
              <div class="rp-bl-meta">{siteRecs.length} 个 · 每周都会打开</div>
            </div>
            <p class="rp-bl-sub">不是导航站，是我真的会反复回去读的地方。</p>
            {blogGroups.map(([cat, items]) => (
              <div class="lk-group">
                <div class="lk-cat">{cat}</div>
                <div class="lk-cards">
                  {items.map((s) => (
                    <a class="lk-card" href={s.url || '#'} target="_blank" rel="noopener noreferrer">
                      <span class="lk-ic">
                        {s.icon ? (
                          <img src={s.icon} alt={`${s.name} 图标`} width="44" height="44" loading="lazy" />
                        ) : (
                          <span class="lk-ic-ph">{s.name.slice(0, 1)}</span>
                        )}
                      </span>
                      <span class="lk-body">
                        <span class="lk-name">{s.name}</span>
                        {s.why && <span class="lk-why">{s.why}</span>}
                      </span>
                      <span class="lk-arrow" aria-hidden="true">›</span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
            <p class="lk-foot">以上链接都在新标签页打开。</p>
          </>
        )}
      </div>
    )}

    {tab.slug === 'opensource' && (
      <div class="rp-grid2 rp-sec-body">
        {openSources.map((o) => (
          <a class="rp-proj" href={o.url || '#'} {...(o.kind === 'project' ? { target: '_blank', rel: 'noopener' } : {})}>
            <div class="rp-proj-t">{o.name}</div>
            <div class="rp-proj-d">{o.desc}</div>
            <div class="rp-proj-foot">
              <span class="rp-proj-kind">{o.kind === 'tutorial' ? '站内阅读 →' : 'GitHub ↗'}</span>
              {/* 用三元而非 &&：stars 为 0 时 && 会把 0 渲染出来 */}
              {o.stars ? <span class="rp-proj-star">★ {o.stars}</span> : null}
            </div>
          </a>
        ))}
      </div>
    )}

    {wip && isEmpty && (
      <div class="rp-wip">
        <div class="rp-wip-t">✎ {wip.t}</div>
        <p class="rp-wip-p">{wip.p}</p>
        <p class="rp-wip-ps">P.S. 你来得比内容还早——这本身就是一种运气。</p>
      </div>
    )}

    <p class="rp-note">更多资源持续整理中，欢迎关注公众号「种一个梦」获取最新更新</p>
  </div>
</BaseLayout>

<style is:global>
  .resources-page { max-width: 960px; margin: 0 auto; padding: 100px 24px 80px; }
  /* 书单 / 常读博客页正文是 680px 居中，头部（面包屑 + 副标题）同步收窄对齐，不再左右突出 */
  .rp-narrow .rp-crumb, .rp-narrow .rp-sub { max-width: 680px; margin-left: auto; margin-right: auto; }

  /* ===== 站内书单（2026-10-18 · 变体 B + 680px 居中，与博客正文同宽）=====
     书单是「阅读类」内容，按用户要求收窄到 680px 居中，不铺满 960px 容器 */
  .rp-booklist { max-width: 680px; margin-left: auto; margin-right: auto; }
  .rp-bl-hd { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; }
  .rp-bl-title { font-family: var(--font-serif, Georgia, serif); font-size: 1.5rem; font-weight: 700; color: var(--color-text, #1c1917); }
  .rp-bl-title .hl { color: var(--color-accent, #f55000); }
  .rp-bl-meta { font-size: 0.82rem; color: var(--color-text-secondary, #78716c); }
  .rp-bl-sub { font-size: 0.88rem; color: var(--color-text-secondary, #78716c); margin: 6px 0 22px; }

  .rp-bl-list { display: flex; flex-direction: column; gap: 20px; }
  /* 纯展示卡：不可点击、无 hover 反馈；保留 1px 灰边框维持边界感 */
  .rp-bl { display: block; position: relative; background: var(--color-card-bg, #fff); border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 12px; color: inherit; overflow: hidden; }

  .rp-bl-top { display: flex; gap: 20px; padding: 18px 20px 16px; }
  .rp-bl-cov { flex: 0 0 84px; width: 84px; height: 118px; }
  .rp-bl-cov img { width: 100%; height: 100%; object-fit: cover; display: block;
    border-radius: 5px; border: 1px solid var(--color-border, #e5e5e5); box-shadow: 0 3px 10px rgba(28,25,23,.1); }
  .rp-bl-cov-ph { width: 100%; height: 100%; border-radius: 5px; border: 1px dashed #d6d3d1; background: #faf9f7;
    display: flex; align-items: center; justify-content: center; color: #a8a29e; font-size: 0.72rem; }

  .rp-bl-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .rp-bl-l1 { display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; }
  /* 序号移到卡片左上角：深色圆形徽标，浮于封面左上角（排名贴纸感） */
  .rp-bl-no { position: absolute; top: 8px; left: 8px; z-index: 2;
    font-family: Georgia, serif; font-size: 0.78rem; font-weight: 700; color: #fff;
    background: rgba(28, 25, 23, 0.72); width: 24px; height: 24px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; }
  .rp-bl-t { font-family: var(--font-serif, Georgia, serif); font-size: 1.1rem; font-weight: 700; line-height: 1.5; color: var(--color-text, #1c1917); }
  .rp-bl-a { font-size: 0.78rem; color: var(--color-text-secondary, #78716c); }
  .rp-bl-d { font-size: 0.85rem; color: var(--color-text-secondary, #78716c); line-height: 1.8; margin-top: 9px; }

  .rp-bl-foot { display: flex; align-items: center; gap: 11px; margin-top: auto; padding-top: 12px; flex-wrap: wrap; }
  .rp-bl-rate { display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; color: #8a7a55; }
  .rp-bl-rate::before { content: '\2605'; color: #e0b95f; font-size: 0.7rem; }
  .rp-bl-rate b { font-family: Georgia, serif; font-size: 0.94rem; color: #c8940f; font-weight: 700; }
  .rp-bl-rate i { font-style: normal; font-size: 0.75rem; }
  .rp-bl-badge { font-size: 0.7rem; line-height: 1; color: #a16207; background: #fdf8ee; border: 1px solid #ecd9b0; border-radius: 999px; padding: 3px 9px; }
  .rp-bl-dot { color: #d6d3d1; }
  .rp-bl-pub { font-size: 0.72rem; color: #b3ada2; }
  .rp-bl-date { font-size: 0.72rem; color: #b3ada2; margin-left: auto; }

  /* 推荐理由：不加独立底色/边框，整卡统一白底（参考微信读书书友圈）
     只靠 ❝ 引号 + 稍浅字色与上方书方信息区分，避免分层过重 */
  .rp-bl-quote { padding: 2px 20px 20px; }
  .rp-bl-qmark { display: block; font-family: Georgia, serif; font-size: 1.75rem; line-height: .7; color: #ccc7c0; margin: 2px 0 12px; }
  .rp-bl-quote p { font-size: 0.88rem; line-height: 2; color: #6b6560; margin: 0 0 10px; }
  .rp-bl-quote p:last-child { margin: 0; }

  /* ===== 常读博客（2026-10-24：分类分组 + 圆形站点头像列表，参考手机「精选」页） ===== */
  .lk-cat { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.02em;
    color: var(--color-text-secondary, #78716c); margin: 30px 0 10px; }
  .lk-group:first-of-type .lk-cat { margin-top: 0; }
  .lk-cards { display: flex; flex-direction: column; gap: 10px; }
  .lk-card { display: flex; align-items: center; gap: 14px; background: var(--color-card-bg, #fff);
    border: 1px solid var(--color-border, #ececec); border-radius: 14px; padding: 13px 16px;
    text-decoration: none; color: inherit; transition: border-color .18s, box-shadow .18s; }
  .lk-card:hover { border-color: #d8d3ca; box-shadow: 0 6px 18px rgba(28,25,23,.07); }
  .lk-ic { flex: none; width: 44px; height: 44px; border-radius: 50%; overflow: hidden;
    background: #faf9f7; border: 1px solid rgba(28,25,23,.06); }
  .lk-ic img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lk-ic-ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-serif, Georgia, serif); font-weight: 700; font-size: 1.05rem;
    color: #fff; background: var(--color-accent, #f55000); }
  .lk-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .lk-name { font-size: 0.98rem; font-weight: 700; line-height: 1.4; color: var(--color-text, #1c1917); }
  .lk-why { font-size: 0.82rem; line-height: 1.65; color: var(--color-text-secondary, #78716c); }
  .lk-arrow { flex: none; font-size: 1.25rem; line-height: 1; color: #c9c4bd; transition: color .18s, transform .18s; }
  .lk-card:hover .lk-arrow { color: var(--color-accent, #f55000); transform: translateX(3px); }
  .lk-card:focus-visible { outline: 2px solid var(--color-accent, #f55000); outline-offset: 3px; }
  .lk-foot { font-size: 0.75rem; color: #a8a29e; margin: 22px 0 0; }

  .rp-sub { color: var(--color-text-secondary, #888); font-size: 0.95rem; margin: 0 0 8px; }
  .rp-sec-body { margin-top: 28px; }
  .rp-group-h { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.08em; color: var(--color-accent, #f55000); margin: 0 0 16px; }
  .rp-group-h-sep { margin-top: 38px; padding-top: 30px; border-top: 1px solid var(--color-border, #e5e5e5); }

  .rp-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .rp-rec { background: var(--color-card-bg, #fff); border: 1px solid var(--color-border, #e5e5e5); border-radius: 12px; padding: 16px 18px; text-decoration: none; color: inherit; transition: all .2s; }
  .rp-rec:hover { border-color: var(--color-accent, #f55000); box-shadow: 0 8px 30px rgba(245,80,0,.1); transform: translateY(-3px); }
  .rp-rec-t { font-size: 0.95rem; font-weight: 700; color: var(--color-text, #1a1a1a); }
  .rp-rec-d { font-size: 0.82rem; color: var(--color-text-secondary, #888); margin-top: 6px; line-height: 1.5; }

  .rp-list .rp-row { display: flex; align-items: center; gap: 14px; background: #faf9f7; border: 1px solid var(--color-border, #e5e5e5); border-radius: 8px; padding: 12px 16px; margin-bottom: 10px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .rp-list .rp-row:hover { border-color: var(--color-accent, #f55000); }
  .rp-row-nm { font-size: 0.9rem; color: var(--color-text, #1a1a1a); }
  .rp-row-why { font-size: 0.78rem; color: var(--color-text-secondary, #888); margin-left: auto; }
  .rp-go { color: var(--color-accent, #f55000); text-decoration: none; }

  .rp-feat { display: flex; align-items: center; gap: 16px; background: var(--color-card-bg, #fff); border: 1px solid var(--color-border, #e5e5e5); border-radius: 12px; padding: 18px 20px; text-decoration: none; color: inherit; transition: all .2s; margin-bottom: 12px; }
  .rp-feat:hover { border-color: var(--color-accent, #f55000); }
  .rp-feat-ic { width: 44px; height: 44px; flex: none; border-radius: 10px; background: #faf9f7; border: 1px solid var(--color-border, #e5e5e5); display: flex; align-items: center; justify-content: center; color: #e8a04c; font-size: 18px; }
  .rp-feat-body { display: flex; flex-direction: column; }
  .rp-feat-t { font-size: 0.95rem; font-weight: 700; color: var(--color-text, #1a1a1a); }
  .rp-feat-d { font-size: 0.78rem; color: var(--color-text-secondary, #888); margin-top: 4px; }
  .rp-feat-lk { margin-left: auto; color: var(--color-accent, #f55000); font-size: 0.82rem; text-decoration: none; white-space: nowrap; }

  .rp-proj { background: var(--color-card-bg, #fff); border: 1px solid var(--color-border, #e5e5e5); border-radius: 12px; padding: 16px 18px; text-decoration: none; color: inherit; transition: all .2s; }
  .rp-proj:hover { border-color: var(--color-accent, #f55000); transform: translateY(-3px); }
  .rp-proj-t { font-size: 0.95rem; font-weight: 700; color: var(--color-text, #1a1a1a); }
  .rp-proj-d { font-size: 0.82rem; color: var(--color-text-secondary, #888); margin-top: 6px; line-height: 1.5; }
  .rp-proj-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 10px; }
  .rp-proj-kind { font-size: 0.78rem; font-weight: 700; color: var(--color-accent, #f55000); }
  .rp-proj-star { font-size: 0.78rem; color: #e8a04c; }

  .rp-note { text-align: center; color: var(--color-text-secondary, #888); font-size: 0.85rem; margin-top: 48px; }
  /* ===== 面包屑（当前位置）+ 下一个分类 ===== */
  .rp-crumb { display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    font-size: 0.85rem; margin: 0 0 20px; padding-bottom: 14px; border-bottom: 1px solid var(--color-border, #e5e5e5); }
  .rp-crumb-l { color: var(--color-text-secondary, #78716c); min-width: 0; }
  .rp-crumb-l a { color: var(--color-text-secondary, #78716c); text-decoration: none; }
  .rp-crumb-l a:hover { color: var(--color-text, #1c1917); text-decoration: underline; }
  .rp-crumb-sep { color: #d6d3d1; margin: 0 7px; }
  .rp-crumb-l b { color: var(--color-text, #1c1917); font-weight: 700; }
  .rp-crumb-next { flex: none; color: var(--color-accent, #f55000); font-weight: 600; text-decoration: none; }
  .rp-crumb-next:hover { text-decoration: underline; }

  /* 未完工占位块 */
  .rp-wip { margin-top: 32px; border: 1.5px dashed var(--color-border, #e5e5e5); border-radius: 14px; padding: 36px 28px; text-align: center; background: #fffdfa; }
  .rp-wip-t { font-family: var(--font-serif, Georgia, serif); font-size: 1.05rem; font-weight: 700; color: var(--color-accent, #f55000); margin-bottom: 10px; letter-spacing: .06em; }
  .rp-wip-p { font-size: 0.92rem; color: var(--color-text-secondary, #666); line-height: 1.9; margin: 0; }
  .rp-wip-ps { margin-top: 12px; font-size: 0.8rem; color: #b3ada2; }

  @media (max-width: 640px) {
    .rp-grid2 { grid-template-columns: 1fr; }
    .resources-page { padding-top: 80px; }
    .rp-h1 { font-size: 1.6rem; }
    /* 面包屑窄屏：分两行，下一行右移对齐 */
    .rp-crumb { flex-direction: column; align-items: flex-start; gap: 8px; }
    /* 书单移动端：封面放大独占一行，引号块内缩 */
    .rp-bl-hd { flex-direction: column; align-items: flex-start; gap: 4px; }
