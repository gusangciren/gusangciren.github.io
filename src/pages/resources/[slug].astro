    .bw-dw-cov .bw-cov-ph { width: 110px; }
    .bw-dw { width: 100%; padding: 22px 18px 28px; border-radius: 14px 14px 0 0; }
  }
</style>

<script>
  // 方案 3：hover 轻反馈（纯 CSS），点击才展开底部抽屉读完整推荐语。
  // 每本书的完整详情放在卡片内的 <template> 里，由 Astro 渲染，避免 JS 里拼 HTML。
  (() => {
    const mask = document.getElementById('bw-mask');
    const dw = document.getElementById('bw-dw');
    const body = document.getElementById('bw-dw-body');
    const closeBtn = document.getElementById('bw-dw-close');
    if (!mask || !dw || !body || !closeBtn) return;

    function open(card) {
      const tpl = card.querySelector('.bw-tpl');
      if (!tpl) return;
      body.innerHTML = tpl.innerHTML;
      const img = body.querySelector('.bw-dw-cov-img');
      const src = card.querySelector('.bw-cov img')?.getAttribute('src');
      if (img && src) img.src = src;
      mask.classList.add('on');
      dw.classList.add('on');
    }
    function close() {
      mask.classList.remove('on');
      dw.classList.remove('on');
    }
    mask.addEventListener('click', close);
    closeBtn.addEventListener('click', close);
    document.querySelectorAll('.bw-card').forEach((c) => {
      c.addEventListener('click', () => open(c));
      c.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(c); }
      });
    });
  })();
</script>
