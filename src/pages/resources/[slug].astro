    transition: opacity .2s, transform .2s; pointer-events: none; }
  .bw-card:hover .bw-hint, .bw-card:focus-visible .bw-hint { opacity: 1; transform: translateY(0); }
  .bw-card:hover .bw-cov img, .bw-card:focus-visible .bw-cov img { transform: scale(1.035); box-shadow: 0 12px 26px rgba(28,25,23,.2); }
