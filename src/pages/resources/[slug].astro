    cursor: pointer; outline: none; text-align: left; }
  .bw-cov { position: relative; overflow: hidden; border-radius: 4px; }
  .bw-cov img, .bw-cov-ph { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; display: block;
    box-shadow: 0 3px 12px rgba(28,25,23,.12); transition: transform .22s, box-shadow .22s; }
  .bw-cov-ph { display: flex; align-items: center; justify-content: center; border-radius: 4px;
