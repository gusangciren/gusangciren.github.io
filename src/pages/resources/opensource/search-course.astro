---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import * as course from '../../../data/courses/search-course.md';

const Content = course.Content;
const allHeadings = await course.getHeadings();
// 目录只收到 h2–h4：h5 太细（5.1 / a、图片搜索 之类），会让目录过长
const toc = allHeadings.filter((h) => h.depth >= 2 && h.depth <= 4);
const clean = (s: string) => s.replace(/\*\*/g, '').trim();
---

<BaseLayout title="搜索课 — 像企业家一样写作">
  <div class="reading-progress" id="reading-progress"></div>

  <div class="reader">
    <header class="reader-hero">
      <div class="reader-hero-inner">
        <div class="reader-hero-text">
          <a href="/resources/opensource/" class="reader-hero-back">← 我的开源</a>
          <div class="reader-hero-book">搜索课</div>
          <div class="reader-hero-chapter">开源教程 · 全文免费 · MIT</div>
          <h1 class="reader-hero-title">10+3 个搜索方法，让搜索成为你的生产力</h1>
          <div class="reader-hero-meta">
            <span>从选项卡、双引号，到 filetype 与站内搜索</span>
            <span class="reader-hero-dot">·</span>
            <span>约 3.6 万字</span>
          </div>
        </div>
      </div>
    </header>

    <div class="reader-body">
      <aside class="reader-toc" id="reader-toc">
        <div class="reader-toc-inner">
          <div class="reader-toc-book">目录</div>
          <nav class="reader-toc-nav">
            {toc.map((h) => (
              <div class="reader-toc-item-wrap">
                <a href={`#${h.slug}`} class="reader-toc-item" data-depth={h.depth}>{clean(h.text)}</a>
              </div>
            ))}
          </nav>
        </div>
      </aside>

      <div class="reader-main">
        <article class="prose reader-prose">
          <Content />
        </article>

        <nav class="reader-footnav">
          <a href="/resources/opensource/" class="reader-next">
            <span class="reader-foot-label">← 返回</span>
            <span class="reader-foot-title">我的开源</span>
          </a>
        </nav>
      </div>
    </div>
  </div>

  <button class="reader-toc-toggle" id="reader-toc-toggle" aria-label="打开目录" aria-expanded="false">目录</button>
  <div class="reader-toc-scrim" id="reader-toc-scrim"></div>
</BaseLayout>

<style is:global>
  /* ===== 阅读进度条 ===== */
  .reading-progress {
    position: fixed; top: 0; left: 0; height: 3px;
    background: #f55000; width: 0%; z-index: 9999;
    opacity: 0; transition: opacity 0.3s ease;
  }
  .reading-progress.show { opacity: 1; }

  /* ===== 书籍同款阅读容器：正文列居中 ===== */
  .reader { position: relative; max-width: 1216px; margin: 0 auto; padding: 0 20px; }

  .reader-hero { padding: 56px 0 30px; border-bottom: 1px solid #f0eeec; margin-bottom: 32px; }
  .reader-hero-inner { display: flex; align-items: flex-start; gap: 28px; max-width: 680px; margin: 0 auto; }
  .reader-hero-text { flex: 1; min-width: 0; }
  .reader-hero-back { display: inline-block; font-size: 12.5px; color: #a8a29e; text-decoration: none; margin-bottom: 16px; transition: color 0.15s; }
  .reader-hero-back:hover { color: var(--color-accent); }
  .reader-hero-book { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 700; color: #1c1917; letter-spacing: 0.01em; margin-bottom: 12px; line-height: 1.45; }
  .reader-hero-chapter { font-size: 12px; font-weight: 700; color: var(--color-accent); letter-spacing: 0.06em; margin-bottom: 12px; }
  .reader-hero-title { font-family: var(--font-serif); font-size: 2.1rem; font-weight: 700; line-height: 1.35; margin: 0 0 14px; color: #1c1917; }
  .reader-hero-meta { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #78716c; flex-wrap: wrap; }
  .reader-hero-dot { color: #d6d3d1; }

  /* 三列：目录 | 正文(居中) | 留白 */
  .reader-body { display: grid; grid-template-columns: minmax(0, 1fr) min(680px, 100%) minmax(0, 1fr); align-items: start; }

  .reader-toc {
    grid-column: 1; justify-self: end;
    width: clamp(150px, 14vw, 210px);
    margin-right: 24px;
    position: sticky; top: 72px;
    max-height: calc(100vh - 92px);
    overflow-y: auto;
    padding: 4px 0 20px;
    scrollbar-width: thin; scrollbar-color: #e7e5e4 transparent;
  }
  .reader-toc::-webkit-scrollbar { width: 4px; }
  .reader-toc::-webkit-scrollbar-thumb { background: #e7e5e4; border-radius: 4px; }
  .reader-toc-book { font-size: 12px; font-weight: 700; color: #a8a29e; letter-spacing: 0.04em; margin-bottom: 16px; }
  .reader-toc-nav { position: relative; padding-left: 18px; }
  .reader-toc-nav::before { content: ''; position: absolute; left: 5px; top: 12px; bottom: 12px; width: 2px; background: #e7e5e4; }
  .reader-toc-item-wrap { position: relative; }
  .reader-toc-item {
    display: block; padding: 9px 8px; text-decoration: none;
    color: #57534e; font-size: 13px; line-height: 1.5;
    border-radius: 6px; transition: background 0.15s, color 0.15s;
  }
  .reader-toc-item[data-depth="3"], .reader-toc-item[data-depth="4"] { font-size: 12.5px; padding-left: 20px; color: #78716c; }
  .reader-toc-item:hover { background: #f5f5f4; color: #1c1917; }
  .reader-toc-item-wrap::before {
    content: ''; position: absolute; left: -13px; top: 15px;
    width: 10px; height: 10px; border-radius: 50%;
    background: #fff; border: 2px solid #d6d3d1; z-index: 1;
  }
  .reader-toc-item-wrap.active .reader-toc-item { color: var(--color-accent); font-weight: 700; background: rgba(245,80,0,0.05); }
  .reader-toc-item-wrap.active::before { background: var(--color-accent); border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(245,80,0,0.15); }

  .reader-main { grid-column: 2; min-width: 0; }
  .reader-prose { max-width: 680px; margin: 0; padding: 0; }

  .reader-footnav { display: flex; gap: 16px; margin-top: 48px; padding-top: 32px; border-top: 1px solid #e7e5e4; }
  .reader-next {
    flex: 1; display: flex; flex-direction: column; gap: 6px;
    align-items: flex-start; text-align: left;
    padding: 14px 22px; border-radius: 12px;
    background: var(--color-accent); color: #fff; text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .reader-next:hover { background: #d94500; transform: translateY(-1px); }
  .reader-next .reader-foot-label { display: block; font-size: 12px; color: rgba(255,255,255,0.8); }
  .reader-next .reader-foot-title { display: block; font-size: 14px; font-weight: 700; color: #fff; }

  /* 移动端目录抽屉 */
  .reader-toc-toggle {
    display: none;
    position: fixed; right: calc(18px + env(safe-area-inset-right)); bottom: calc(22px + env(safe-area-inset-bottom));
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--color-accent); color: #fff; border: none;
    font-size: 13px; font-weight: 600;
    box-shadow: 0 6px 18px rgba(245,80,0,0.32);
    z-index: 60; cursor: pointer;
  }
  .reader-toc-scrim { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 55; }
  body.toc-open .reader-toc-scrim { display: block; }
  body.toc-open .reader-toc { transform: translateX(0) !important; }
  /* 抽屉打开时锁住正文滚动（仅抽屉生效的窄屏，避免桌面滚动条消失导致布局跳动） */
  @media (max-width: 1120px) {
    body.toc-open { overflow: hidden; }
  }

  /* 装不下侧栏时（<1120px）降级为抽屉 */
  @media (max-width: 1120px) {
    .reader { padding: 0 16px; }
    .reader-hero { padding: 36px 0 22px; }
    .reader-hero-title { font-size: 1.7rem; }
    .reader-body { display: block; }
    .reader-toc {
      position: fixed; top: 0; left: 0; bottom: 0;
      width: 80%; max-width: 300px; background: #fff; z-index: 58;
      padding: 20px 16px; transform: translateX(-100%);
      transition: transform 0.3s ease; box-shadow: 4px 0 24px rgba(0,0,0,0.1);
      margin-right: 0;
    }
    .reader-toc-toggle { display: flex; align-items: center; justify-content: center; }
    .reader-prose { max-width: 100%; }
    .reader-next { align-items: flex-start; text-align: left; }
  }
</style>

<script is:inline>
  (function () {
    var bar = document.getElementById('reading-progress');
    var doc = document.documentElement;
    var links = Array.prototype.slice.call(document.querySelectorAll('.reader-toc-item'));
    var targets = links.map(function (a) {
      return { a: a, el: document.getElementById(a.getAttribute('href').slice(1)) };
    }).filter(function (t) { return t.el; });

    function highlight() {
      var current = null;
      targets.forEach(function (t) {
        if (t.el.getBoundingClientRect().top <= 120) current = t;
      });
      links.forEach(function (a) { a.parentNode.classList.remove('active'); });
      if (current) current.a.parentNode.classList.add('active');
    }

    function onScroll() {
      var max = doc.scrollHeight - window.innerHeight;
      if (bar) {
        bar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + '%';
        if (window.scrollY > 120) bar.classList.add('show'); else bar.classList.remove('show');
      }
      highlight();
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    // 窗口尺寸变化会改变滚动上限与标题位置，必须重算，否则进度条/高亮停留在旧值
    window.addEventListener('resize', onScroll);
    highlight();

    // 移动端目录抽屉
    var toggle = document.getElementById('reader-toc-toggle');
    var scrim = document.getElementById('reader-toc-scrim');
    function syncToggle() {
      if (!toggle) return;
      var open = document.body.classList.contains('toc-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? '关闭目录' : '打开目录');
    }
    function closeToc() { document.body.classList.remove('toc-open'); syncToggle(); }
    syncToggle();
    if (toggle) toggle.addEventListener('click', function () {
      if (document.body.classList.contains('toc-open')) closeToc();
      else document.body.classList.add('toc-open');
      syncToggle();
    });
    if (scrim) scrim.addEventListener('click', closeToc);
    links.forEach(function (a) { a.addEventListener('click', closeToc); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeToc(); });
  })();
</script>
